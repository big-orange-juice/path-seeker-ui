@@ -0,0 +1,73 @@
+using System.Reflection;
+using CulturalTourismSystem.Common.Exceptions;
+using CulturalTourismSystem.IRepository;
+using CulturalTourismSystem.Model.DataBase;
+using CulturalTourismSystem.Model.Request;
+using CulturalTourismSystem.Service;
+using Microsoft.Extensions.Logging.Abstractions;
+using Xunit;
+
+namespace CulturalTourismSystem.ApiTests;
+
+public sealed class AppUserDriverTests
+{
+    [Fact]
+    public async Task Admin_grants_phone_bound_permission_and_can_revoke_after_account_is_disabled()
+    {
+        var (service, repository) = Fixture();
+        await service.ChangeDriverAsync(new() { UserId = repository.User.Id.ToString(), IsDriver = true, Phone = " 13800138000 " });
+        Assert.True(repository.User.IsDriver);
+        Assert.Equal("13800138000", repository.User.Phone);
+        Assert.Equal(repository.User.Phone, repository.User.DriverPhone);
+        repository.User.Status = 2;
+        await service.ChangeDriverAsync(new() { UserId = repository.User.Id.ToString(), IsDriver = false });
+        Assert.False(repository.User.IsDriver);
+        Assert.Null(repository.User.DriverPhone);
+        Assert.Equal("13800138000", repository.User.Phone);
+        Assert.Equal(2, repository.Updates);
+    }
+
+    [Theory]
+    [InlineData(null, "13800138000", true, 1, 6)]
+    [InlineData("13900139000", "13800138000", false, 1, 6)]
+    [InlineData(null, "invalid", false, 1, 6)]
+    [InlineData(null, "13800138000", false, 2, 6)]
+    [InlineData(null, "13800138000", false, 1, 5)]
+    public async Task Invalid_or_conflicting_phone_and_ineligible_accounts_cannot_be_granted(
+        string? existingPhone, string requestedPhone, bool conflict, short status, short channel)
+    {
+        var (service, repository) = Fixture();
+        repository.User.Phone = existingPhone;
+        repository.User.Status = status;
+        repository.User.RegisterChannel = channel;
+        repository.PhoneConflict = conflict;
+        await Assert.ThrowsAsync<ValidationException>(() => service.ChangeDriverAsync(new()
+        {
+            UserId = repository.User.Id.ToString(), IsDriver = true, Phone = requestedPhone
+        }));
+        Assert.False(repository.User.IsDriver);
+        Assert.Equal(0, repository.Updates);
+    }
+
+    private static (AppUserService Service, UserRepositoryProxy Repository) Fixture()
+    {
+        var users = DispatchProxy.Create<IAppUserRepository, UserRepositoryProxy>();
+        var service = new AppUserService(users, null!, null!, null!, null!, null!, null!,
+            NullLogger<AppUserService>.Instance, null!, null!);
+        return (service, (UserRepositoryProxy)(object)users);
+    }
+
+    public class UserRepositoryProxy : DispatchProxy
+    {
+        public AppUser User { get; } = new() { Id = 9223372036854775806, RegisterChannel = 6, Status = 1 };
+        public bool PhoneConflict { get; set; }
+        public int Updates { get; private set; }
+        protected override object? Invoke(MethodInfo? method, object?[]? arguments)
+        {
+            if (method!.Name == "GetByIdAsync") return Task.FromResult<AppUser?>(User);
+            if (method.Name == "ExistsAsync") return Task.FromResult(PhoneConflict);
+            if (method.Name == "UpdateAsync") { Updates++; return Task.FromResult(User.Id); }
+            throw new NotSupportedException(method.Name);
+        }
+    }
+}
