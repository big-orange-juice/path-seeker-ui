+    private async Task EndRoomAsync(TranslationRoomState room, bool immediate, string reason)
+    {
+        Task inputTask;
+        lock (room.Gate)
+        {
+            if (room.Record.Status == "closed") return;
+            if (immediate)
+            {
+                room.Record.Status = "closed";
+                room.Record.ClosedReason = reason;
+                room.Send("room.closed", new { mode = "immediate", reason });
+                room.Lifetime.Cancel();
+            }
+            else
+            {
+                room.Record.Status = "draining";
+                room.Send("room.draining");
+                room.Input?.Cancel();
+            }
+            inputTask = room.InputTask;
+        }
+        await PersistAsync(room);
+        if (immediate) return;
+        await inputTask;
+        Task[] workers;
+        lock (room.Gate)
+        {
+            foreach (var language in room.Languages.Values) language.Queue.Writer.TryComplete();
+            workers = room.Languages.Values.Select(language => language.Worker).ToArray();
+        }
+        try { await Task.WhenAll(workers); } catch (OperationCanceledException) { }
+        lock (room.Gate)
+        {
+            if (room.Record.Status == "closed") return;
+            room.Record.Status = "closed";
+            room.Record.ClosedReason = reason;
+            room.Send("room.output.completed");
+            room.Send("room.closed", new { mode = "normal", reason });
+        }
+        await PersistAsync(room);
+    }
