+                .SetColumns(record => new TranslationRoom { Status = status, ClosedReason = reason, UpdatedAt = DateTimeOffset.UtcNow })
+                .Where(record => record.Id == room.Record.Id).ExecuteCommandAsync();
+        }
+        finally { persistence.Release(); }
