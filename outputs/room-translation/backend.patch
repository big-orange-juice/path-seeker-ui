+public sealed class TranslationRoomService(
+    IServiceScopeFactory scopes, SnowflakeIdGenerator ids, ILogger<TranslationRoomService> logger) : BackgroundService
+{
+    private readonly ConcurrentDictionary<long, TranslationRoomState> rooms = new();
+    private readonly SemaphoreSlim creation = new(1, 1);
+    private readonly SemaphoreSlim generation = new(12, 12);
+    private readonly SemaphoreSlim persistence = new(1, 1);
+
+    public async Task<object[]> HostVehiclesAsync(long userId)
+    {
+        using var scope = scopes.CreateScope();
+        var user = await UserAsync(scope.ServiceProvider, userId);
+        if (user.RegisterChannel == 5 || string.IsNullOrWhiteSpace(user.Phone)) return [];
+        var vehicles = await scope.ServiceProvider.GetRequiredService<IRickshawVehicleRepository>()
+            .GetListAsync(vehicle => vehicle.DriverUserId == userId && vehicle.DriverPhone == user.Phone
+                && vehicle.Status == RickshawStatuses.Enabled);
+        return vehicles.Select(vehicle => (object)new
+        {
+            rickshawId = vehicle.Id.ToString(), vehicle.VehicleNo, vehicle.DriverName
+        }).ToArray();
+    }
+
+    public async Task<object> CreateAsync(long userId, CreateTranslationRoomRequest request)
+    {
+        ValidateLanguage(request.SourceLanguage);
+        var vehicle = await HostAsync(userId, request.RickshawId.ToLongIdRequired());
+        await creation.WaitAsync();
+        try
+        {
+            var existing = rooms.Values.FirstOrDefault(room => room.Record.RickshawId == vehicle.Id && room.Record.Status != "closed");
+            if (existing != null)
+            {
+                if (existing.Record.HostUserId != userId) throw Forbidden("该车辆已有其他车夫的讲解房间");
+                lock (existing.Gate) return existing.Snapshot(userId);
+            }
+            if (rooms.Values.Count(room => room.Record.Status != "closed") >= 10) throw Invalid("讲解房间已达上限");
+            string code;
+            do { code = RandomNumberGenerator.GetInt32(10000000, 100000000).ToString(); }
+            while (rooms.Values.Any(room => room.Record.JoinCode == code));
+            var record = new TranslationRoom
+            {
+                Id = ids.NextId(), RickshawId = vehicle.Id, HostUserId = userId, JoinCode = code,
+                SourceLanguage = Language(request.SourceLanguage!.Value),
+                ExpiresAt = DateTimeOffset.UtcNow.AddMinutes(30)
+            };
+            using var scope = scopes.CreateScope();
+            await scope.ServiceProvider.GetRequiredService<ISqlSugarClient>().Insertable(record).ExecuteCommandAsync();
+            var state = new TranslationRoomState { Record = record };
+            rooms[record.Id] = state;
+            return state.Snapshot(userId);
+        }
+        finally { creation.Release(); }
+    }
+
+    public async Task<object> JoinAsync(long userId, JoinTranslationRoomRequest request)
+    {
+        ValidateLanguage(request.TargetLanguage);
+        using var scope = scopes.CreateScope();
+        await UserAsync(scope.ServiceProvider, userId);
+        var room = rooms.Values.FirstOrDefault(item => item.Record.JoinCode == request.Code)
+            ?? throw Invalid("房间码无效或房间已结束");
+        lock (room.Gate)
+        {
+            EnsureOpen(room);
+            if (room.Record.HostUserId == userId) return room.Snapshot(userId);
+            if (!room.Members.ContainsKey(userId) && room.Members.Count >= 30) throw Invalid("房间人数已满");
+            if (room.Members.TryGetValue(userId, out var previous)) previous.Connection?.Lifetime.Cancel();
+            room.Members[userId] = new TranslationRoomMember
+            {
+                UserId = userId, Language = request.TargetLanguage!.Value,
+                Version = (previous?.Version ?? 0) + 1
+            };
+            return room.Snapshot(userId);
+        }
+    }
+
+    public async Task<object> GetAsync(long userId, long roomId)
+    {
+        var room = RequireRoom(roomId);
+        using var scope = scopes.CreateScope();
+        await UserAsync(scope.ServiceProvider, userId);
+        if (room.Record.HostUserId == userId) await HostAsync(userId, room.Record.RickshawId);
+        lock (room.Gate)
+        {
+            if (room.Record.HostUserId != userId && !room.Members.ContainsKey(userId)) throw Forbidden("请先加入房间");
+            return room.Snapshot(userId);
+        }
+    }
+
+    public Task LeaveAsync(long userId, long roomId)
+    {
+        var room = RequireRoom(roomId);
+        lock (room.Gate)
+        {
+            if (room.Members.Remove(userId, out var member)) member.Connection?.Lifetime.Cancel();
+            room.MembersChanged();
+        }
+        return Task.CompletedTask;
+    }
+
+    public void Subscribe(long userId, long roomId, TranslationRoomSubscriptionRequest request)
+    {
+        ValidateLanguage(request.TargetLanguage);
+        var room = RequireRoom(roomId);
+        lock (room.Gate)
+        {
+            EnsureOpen(room);
+            if (!room.Members.TryGetValue(userId, out var member)) throw Forbidden("请先加入房间");
+            EnsureLanguageCapacity(room, request.TargetLanguage!.Value, userId);
+            member.Language = request.TargetLanguage.Value;
+            member.Version++;
+            member.StartSequence = room.Sequence + 1;
+            member.Connection?.Send(Ready(room, member, "subscription.changed"));
+            room.MembersChanged();
+        }
+    }
+
+    public async Task EndAsync(long userId, long roomId, bool immediate)
+    {
+        var room = RequireRoom(roomId);
+        await HostAsync(userId, room.Record.RickshawId);
+        if (room.Record.HostUserId != userId) throw Forbidden("仅房主可结束讲解");
+        await EndRoomAsync(room, immediate, immediate ? "host_closed" : "host_ended");
+    }
