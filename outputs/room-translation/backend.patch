+    public object Snapshot(long userId) => new
+    {
+        roomId = Record.Id.ToString(), rickshawId = Record.RickshawId.ToString(),
+        isHost = Record.HostUserId == userId, code = Record.JoinCode,
+        sourceLanguage = Record.SourceLanguage, status = Record.Status, expiresAt = Record.ExpiresAt,
+        epochId = EpochId.ToString(), sequence = Sequence,
+        listenerCount = Members.Values.Count(member => member.Connection != null),
+        languages = Record.HostUserId == userId
+            ? Members.Values.Where(member => member.Connection != null).GroupBy(member => member.Language)
+                .Select(group => new { language = group.Key, count = group.Count() }).ToArray()
+            : null
+    };
