+    public async Task EventsAsync(WebSocket socket, long userId, long roomId, CancellationToken requestToken)
+    {
+        var room = RequireRoom(roomId);
+        await GetAsync(userId, roomId);
+        var connection = new TranslationRoomConnection();
+        var host = room.Record.HostUserId == userId;
+        lock (room.Gate)
+        {
+            EnsureOpen(room);
+            if (host)
+            {
+                room.Host?.Lifetime.Cancel();
+                room.Host = connection;
+                connection.Send(new { type = "room.snapshot", payload = room.Snapshot(userId) });
+            }
+            else
+            {
+                if (!room.Members.TryGetValue(userId, out var member)) throw Forbidden("请先加入房间");
+                EnsureLanguageCapacity(room, member.Language, userId);
+                member.Connection?.Lifetime.Cancel();
+                member.Connection = connection;
+                member.StartSequence = room.Sequence + 1;
+                member.Version++;
+                connection.Send(Ready(room, member, "subscription.ready"));
+                room.MembersChanged();
+            }
+        }
+        using var lifetime = CancellationTokenSource.CreateLinkedTokenSource(requestToken, connection.Lifetime.Token);
+        async Task SendAsync()
+        {
+            await foreach (var bytes in connection.Events.Reader.ReadAllAsync(lifetime.Token))
+                await socket.SendAsync(bytes.AsMemory(), WebSocketMessageType.Text, true, lifetime.Token);
+        }
+        async Task ReceiveAsync()
+        {
+            while (!lifetime.IsCancellationRequested)
+            {
+                var frame = await ReceiveFrameAsync(socket, lifetime.Token);
+                if (frame.Type == WebSocketMessageType.Close) break;
+                if (frame.Type != WebSocketMessageType.Text
+                    || JsonDocument.Parse(frame.Data).RootElement.GetProperty("type").GetString() != "ping")
+                    throw Invalid("收听连接仅接受心跳消息");
+                connection.LastSeen = DateTimeOffset.UtcNow;
+                connection.Send(new { type = "pong" });
+            }
+        }
+        var sending = SendAsync();
+        var receiving = ReceiveAsync();
+        try { await await Task.WhenAny(sending, receiving); }
+        catch (Exception exception) when (exception is OperationCanceledException or WebSocketException) { }
+        finally
+        {
+            lifetime.Cancel();
+            try { await Task.WhenAll(sending, receiving); } catch (Exception) { }
+            lock (room.Gate)
+            {
+                if (host && room.Host == connection) room.Host = null;
+                if (!host && room.Members.TryGetValue(userId, out var member) && member.Connection == connection)
+                {
+                    room.Members.Remove(userId);
+                    room.MembersChanged();
+                }
+            }
+            connection.Events.Writer.TryComplete();
+            connection.Lifetime.Dispose();
+            socket.Abort();
+        }
+    }
