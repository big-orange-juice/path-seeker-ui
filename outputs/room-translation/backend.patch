+    public void Send(string type, object? payload = null, TranslationRoomCommit? commit = null,
+        TranslationTargetLanguage? language = null)
+    {
+        var eventId = Guid.NewGuid().ToString("N");
+        object Envelope(int version) => new
+        {
+            type, roomId = Record.Id.ToString(), epochId = (commit?.EpochId ?? EpochId).ToString(),
+            eventId, sequence = commit?.Sequence ?? Sequence, targetLanguage = language,
+            subscriptionVersion = version, payload
+        };
+        if (language == null) Host?.Send(Envelope(0));
+        foreach (var member in Members.Values)
+        {
+            if (member.Connection == null || (language != null && member.Language != language)
+                || (commit != null && commit.Sequence < member.StartSequence)) continue;
+            member.Connection.Send(Envelope(member.Version));
+        }
+    }
