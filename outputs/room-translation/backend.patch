+                            if (now - language.Value.LastUsed <= TimeSpan.FromSeconds(15)
+                                || room.Members.Values.Any(member => member.Connection != null && member.Language == language.Key)) continue;
+                            language.Value.Queue.Writer.TryComplete();
+                            if (language.Value.Worker.IsCompleted) room.Languages.Remove(language.Key);
+                        }
