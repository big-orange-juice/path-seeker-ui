+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        using (var scope = scopes.CreateScope())
+        {
+            await scope.ServiceProvider.GetRequiredService<ISqlSugarClient>().Updateable<TranslationRoom>()
+                .SetColumns(room => new TranslationRoom { Status = "closed", ClosedReason = "server_restarted" })
+                .Where(room => room.Status != "closed").ExecuteCommandAsync();
+        }
+        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
+        while (await timer.WaitForNextTickAsync(stoppingToken))
+        {
+            foreach (var room in rooms.Values)
