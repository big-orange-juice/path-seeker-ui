+                try
+                {
+                    var now = DateTimeOffset.UtcNow;
+                    lock (room.Gate)
+                    {
+                        foreach (var member in room.Members.Values.ToArray())
+                        {
+                            if (member.Connection == null && now - member.JoinedAt > TimeSpan.FromSeconds(45))
+                                room.Members.Remove(member.UserId);
+                            else if (member.Connection != null && now - member.Connection.LastSeen > TimeSpan.FromSeconds(45))
+                                member.Connection.Lifetime.Cancel();
+                        }
+                        if (room.Host != null && now - room.Host.LastSeen > TimeSpan.FromSeconds(45)) room.Host.Lifetime.Cancel();
+                        foreach (var language in room.Languages.ToArray())
