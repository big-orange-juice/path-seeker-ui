<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:baselineAligned="false">
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginStart="16dp" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card">
        <FrameLayout android:id="@+id/map_host" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@color/driver_map_surface" />
        <TextView android:id="@+id/map_message" style="@style/DriverCaption"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_margin="10dp" android:layout_marginEnd="68dp" android:padding="12dp"
            android:gravity="center_vertical" android:background="@drawable/bg_map_control" android:text="@string/map_loading"
            android:maxLines="2" android:clickable="true" android:focusable="true" />
        <ImageButton android:id="@+id/recenter" style="@style/DriverIconButton"
            android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end"
            android:layout_margin="10dp" android:background="@drawable/bg_map_control"
            android:src="@drawable/ic_locate" android:contentDescription="@string/recenter_action" />
    </FrameLayout>
    <ScrollView android:layout_width="336dp" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <include layout="@layout/view_console_room" />
            <View android:layout_width="1dp" android:layout_height="12dp" />
            <include layout="@layout/view_console_controls" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
