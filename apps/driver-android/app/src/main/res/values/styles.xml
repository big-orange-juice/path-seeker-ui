<resources>
    <style name="DriverTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/driver_teal</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/driver_background</item>
        <item name="android:navigationBarColor">@color/driver_background</item>
        <item name="android:windowBackground">@color/driver_background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="DriverConsoleTheme" parent="DriverTheme">
        <item name="android:windowBackground">@null</item>
    </style>
    <style name="DriverCaption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/driver_muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="DriverBody">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/driver_ink</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="DriverPrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="DriverTextButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/driver_teal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">44dp</item>
    </style>
    <style name="DriverInput">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/driver_ink</item>
        <item name="android:textColorHint">@color/driver_muted</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
