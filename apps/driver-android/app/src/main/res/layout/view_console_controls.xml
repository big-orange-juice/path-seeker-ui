<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="12dp"
    android:padding="@dimen/console_control_padding" android:background="@drawable/bg_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView style="@style/DriverSectionLabel" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/transcript_label" />
        <TextView android:id="@+id/commentary_badge" style="@style/DriverSectionLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_status"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:text="@string/commentary_badge_idle" />
    </LinearLayout>
    <TextView android:id="@+id/commentary_text" style="@style/DriverBody"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/console_transcript_min_height"
        android:layout_marginTop="@dimen/console_transcript_gap" android:textSize="17sp" android:lineSpacingExtra="4dp"
        android:text="@string/commentary_text_waiting" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/commentary_state" style="@style/DriverCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="@string/commentary_idle" android:maxLines="2" android:ellipsize="end" android:accessibilityLiveRegion="polite" />
    <ProgressBar android:id="@+id/microphone_level" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="@dimen/console_meter_gap" android:max="100"
        android:progressDrawable="@drawable/progress_microphone" android:contentDescription="@string/microphone_level" />
    <Button android:id="@+id/microphone_action" style="@style/DriverPrimaryButton"
        android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="@dimen/console_action_gap"
        android:background="@drawable/bg_mic" android:drawableStart="@drawable/ic_microphone" android:drawablePadding="12dp"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:text="@string/commentary_start" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="@dimen/console_nav_gap">
        <Button android:id="@+id/details_action" style="@style/DriverTextButton"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/trip_details" />
        <View android:layout_width="1dp" android:layout_height="16dp" android:layout_gravity="center_vertical" android:background="@color/driver_line" />
        <Button android:id="@+id/questions_action" style="@style/DriverTextButton"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/questions_action" />
    </LinearLayout>
    <TextView android:id="@+id/feedback" style="@style/DriverCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:paddingTop="4dp" android:paddingBottom="4dp" android:textColor="@color/driver_error"
        android:accessibilityLiveRegion="polite" android:visibility="gone" />
</LinearLayout>
