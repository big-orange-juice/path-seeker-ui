<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="16dp"
    android:paddingBottom="4dp" android:background="@drawable/bg_console_panel">
    <TextView style="@style/DriverSectionLabel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/transcript_label" />
    <TextView android:id="@+id/commentary_text" style="@style/DriverBody"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp"
        android:layout_marginTop="6dp" android:text="@string/commentary_text_waiting"
        android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/commentary_state" style="@style/DriverCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/commentary_idle" android:maxLines="2"
        android:ellipsize="end" android:accessibilityLiveRegion="polite" />
    <ProgressBar android:id="@+id/microphone_level" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="10dp"
        android:max="100" android:progressTint="@color/driver_teal"
        android:progressBackgroundTint="@color/driver_line" android:contentDescription="@string/microphone_level" />
    <Button android:id="@+id/microphone_action" style="@style/DriverPrimaryButton"
        android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp"
        android:background="@drawable/bg_mic" android:drawableStart="@drawable/ic_microphone"
        android:drawablePadding="12dp" android:paddingStart="20dp" android:paddingEnd="20dp"
        android:text="@string/commentary_start" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp">
        <Button android:id="@+id/details_action" style="@style/DriverTextButton"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:text="@string/trip_details" />
        <View android:layout_width="1dp" android:layout_height="16dp" android:layout_gravity="center_vertical"
            android:background="@color/driver_line" />
        <Button android:id="@+id/questions_action" style="@style/DriverTextButton"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:text="@string/questions_action" />
    </LinearLayout>
    <TextView android:id="@+id/feedback" style="@style/DriverCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="4dp" android:paddingBottom="8dp" android:textColor="@color/driver_error"
        android:accessibilityLiveRegion="polite" android:visibility="gone" />
</LinearLayout>
