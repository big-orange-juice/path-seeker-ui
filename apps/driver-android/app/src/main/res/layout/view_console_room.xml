<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/console_header_height" android:gravity="center_vertical">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="12dp"
            android:padding="8dp" android:background="@drawable/bg_soft" android:src="@drawable/ic_route"
            android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/console_heading" android:textSize="21sp" android:fontFamily="sans-serif-medium"
                android:textColor="@color/driver_ink" android:includeFontPadding="false" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="17sp" android:autoSizeMaxTextSize="21sp" />
            <TextView android:id="@+id/account_name" style="@style/DriverCaption"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageButton android:id="@+id/settings" style="@style/DriverIconButton"
            android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="4dp"
            android:src="@drawable/ic_settings" android:contentDescription="@string/settings_action" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:orientation="vertical" android:background="@drawable/bg_room" android:padding="@dimen/console_card_padding">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                style="@style/DriverSectionLabel" android:text="@string/console_title" android:textColor="@color/driver_on_dark" />
            <TextView android:id="@+id/connection_badge" style="@style/DriverSectionLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp"
                android:textColor="@color/driver_on_dark" android:background="@drawable/bg_room_status" android:text="@string/room_waiting" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:gravity="center_vertical">
            <TextView android:id="@+id/room_code" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:gravity="center_vertical" android:text="@string/no_room_code" android:textColor="@android:color/white"
                android:fontFamily="sans-serif-medium" android:textSize="28sp" android:letterSpacing="0.04" android:fontFeatureSettings="tnum"
                android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="17sp"
                android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:ellipsize="end" />
            <Button android:id="@+id/room_action" style="@style/DriverTextButton"
                android:layout_width="108dp" android:layout_height="48dp" android:layout_marginStart="12dp"
                android:background="@drawable/bg_soft" android:text="@string/create_room_action" />
        </LinearLayout>
        <TextView android:id="@+id/listener_count" style="@style/DriverCaption" android:textColor="@color/driver_on_dark"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/listeners_waiting" />
    </LinearLayout>
</LinearLayout>
