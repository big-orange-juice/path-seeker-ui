<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="10dp"
            android:src="@drawable/ic_route" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/console_heading" android:textSize="20sp"
            android:fontFamily="sans-serif-medium" android:textColor="@color/driver_ink"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" />
        <Button android:id="@+id/settings" style="@style/DriverTextButton"
            android:layout_width="64dp" android:layout_height="48dp" android:text="@string/settings_action" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                style="@style/DriverSectionLabel" android:text="@string/console_title" />
            <TextView android:id="@+id/connection_badge" style="@style/DriverSectionLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp"
                android:background="@drawable/bg_status" android:text="@string/room_waiting" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:gravity="center_vertical">
            <TextView android:id="@+id/room_code" android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:gravity="center_vertical" android:text="@string/no_room_code"
                android:textColor="@color/driver_ink" android:fontFamily="monospace" android:textSize="28sp"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="28sp"
                android:autoSizeStepGranularity="1sp" android:maxLines="1" android:ellipsize="end" />
            <Button android:id="@+id/room_action" style="@style/DriverTextButton"
                android:layout_width="104dp" android:layout_height="48dp" android:background="@drawable/bg_soft"
                android:text="@string/create_room_action" />
        </LinearLayout>
        <TextView android:id="@+id/listener_count" style="@style/DriverCaption"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/listeners_waiting" />
        <TextView android:id="@+id/account_name" style="@style/DriverSectionLabel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
