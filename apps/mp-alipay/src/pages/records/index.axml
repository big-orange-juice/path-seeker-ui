<scroll-view class="full-page" scroll-y="true" onScrollToLower="more"><view class="page"><view class="eyebrow">PATH SEEKER · 行程与足迹</view><view class="title">走过的路，都有回响。</view><view class="tabs"><button a:for="{{tabs}}" a:key="*this" class="{{tab === index ? 'primary' : ''}}" size="mini" data-index="{{index}}" onTap="choose">{{item}}</button></view><view a:if="{{tab === 0}}" class="muted">此设备上的漫游记录。换设备后可在路线中恢复未结束行程。</view>
  <view a:if="{{error}}" class="error">{{error}}<button onTap="retry" size="mini">重试</button></view>
  <view a:for="{{records}}" a:key="renderKey" class="card"><view class="row"><image a:if="{{item.coverImageUrl}}" src="{{item.coverImageUrl}}" class="cover" mode="aspectFill"/><view class="grow"><view class="record-title">{{item.routeTitle}}</view><view class="muted">{{item.dateLabel}} · {{item.statusLabel}}</view><view class="muted">{{item.progressLabel}}</view><view a:if="{{item.footprintNo}}" class="pill">足迹 {{item.footprintNo}}</view></view></view><button class="resume" data-id="{{item.routeId}}" onTap="resume">{{tab === 0 && item.status === 1 ? '继续行程' : '查看路线'}}</button></view>
  <view a:if="{{loading}}" class="empty">正在加载…</view><view a:elif="{{!records.length &amp;&amp; !error}}" class="empty">还没有记录，开始一段新的旅程吧。</view><button a:if="{{hasMore}}" disabled="{{loading}}" onTap="more">加载更多</button>
</view></scroll-view>
