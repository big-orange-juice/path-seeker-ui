.room-page{height:100vh;background:#f8faf9;color:#183e43;padding:32rpx 36rpx calc(60rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.room-header{display:flex;align-items:center;justify-content:space-between;min-height:64rpx;color:#587066;font-size:24rpx}
.room-back{min-height:80rpx;margin:0;padding:12rpx 0;background:transparent;color:#183e43;font-size:26rpx;text-align:left}
.room-intro{margin:36rpx 0}
.room-page-title{font:600 56rpx/1.3 'Noto Serif SC','Songti SC','STSong',serif;letter-spacing:2rpx}
.room-intro-copy{margin-top:14rpx;color:#7b8a80;font-size:24rpx;line-height:1.6}
.room-notice{display:flex;align-items:center;gap:14rpx;margin-bottom:32rpx;color:#587066;font-size:23rpx;line-height:1.6}
.room-status-dot{flex:0 0 12rpx;width:12rpx;height:12rpx;border-radius:50%;background:#6b8d7c}
.room-card{padding:40rpx;margin-bottom:32rpx;border:1px solid #d4e0d9;border-radius:34rpx;background:#fff;box-shadow:0 10rpx 40rpx #183e4307}
.room-card-heading{display:flex;align-items:center;gap:22rpx;margin-bottom:40rpx}
.room-card-icon{display:flex;align-items:center;justify-content:center;flex:0 0 78rpx;width:78rpx;height:78rpx;border-radius:24rpx;background:#edf5ef;color:#183e43}
.room-headphones-icon{position:relative;box-sizing:border-box;width:36rpx;height:34rpx;border:4rpx solid currentColor;border-bottom:0;border-radius:22rpx 22rpx 0 0}
.room-headphones-icon::before,.room-headphones-icon::after{position:absolute;bottom:-2rpx;width:8rpx;height:18rpx;border-radius:4rpx;background:currentColor;content:''}
.room-headphones-icon::before{left:-4rpx}.room-headphones-icon::after{right:-4rpx}
.room-heading-copy{flex:1;min-width:0}
.room-title{font-size:34rpx;font-weight:600;line-height:1.4}
.room-description{margin-top:8rpx;color:#7b8a80;font-size:22rpx;line-height:1.6}
.room-field-group{margin-bottom:40rpx}
.room-label{margin-bottom:18rpx;color:#2b4039;font-size:24rpx;font-weight:600}
.room-code-input{width:100%;height:104rpx;padding:20rpx 26rpx;border:1px solid #d4e0d9;border-radius:22rpx;background:#f8faf9;color:#183e43;font-size:44rpx;font-weight:600;letter-spacing:9rpx;text-align:center}
.room-code-placeholder{color:#91a39a;font-size:28rpx;font-weight:400;letter-spacing:2rpx}
.room-language-options{display:flex;flex-wrap:wrap;justify-content:space-between;gap:14rpx}
.room-language-option{display:flex;align-items:center;justify-content:space-between;width:calc(50% - 7rpx);min-height:82rpx;margin:0;padding:18rpx 22rpx;border:1px solid #d4e0d9;border-radius:18rpx;background:#f8faf9;color:#587066;font-size:26rpx;font-weight:400}
.room-language-option.is-selected{border-color:#183e43;background:#edf5ef;color:#183e43;font-weight:600}
.room-action{display:flex;align-items:center;justify-content:center;gap:18rpx;width:100%;min-height:90rpx;margin:24rpx 0 0;padding:22rpx 28rpx;border:1px solid #d4e0d9;border-radius:22rpx;background:#f8faf9;color:#183e43;font-size:26rpx;font-weight:600;line-height:1.5}
.room-action-primary{border-color:#183e43;background:#183e43;color:#fff;box-shadow:0 8rpx 22rpx #183e4318}
.room-action-danger{border-color:#ecd8d1;background:#fff8f5;color:#a4483b}
.room-action-quiet{border-color:transparent;background:transparent;color:#667e7c}
.room-scan{min-height:72rpx;margin:-18rpx 0 36rpx;padding:14rpx 24rpx;background:#edf5ef;font-size:24rpx;font-weight:400}
.room-help{margin-top:20rpx;color:#7b8a80;font-size:21rpx;line-height:1.7;text-align:center}
.room-error{padding:22rpx 26rpx;margin-bottom:32rpx;border:1px solid #ecd8d1;border-radius:22rpx;background:#fff8f5;color:#a4483b;font-size:24rpx;line-height:1.6}
.room-session-heading{text-align:center;margin-bottom:36rpx}
.room-caption{color:#7b8a80;font-size:22rpx;line-height:1.6}
.room-session-code{margin-top:14rpx;color:#183e43;font-size:56rpx;font-weight:600;letter-spacing:9rpx;word-break:break-all}
.room-members{margin:20rpx 0;color:#587066;font-size:24rpx;line-height:1.7}
.room-transcript{margin:36rpx 0;padding:28rpx;border-radius:22rpx;background:#f8faf9}
.room-subtitle{margin:10rpx 0 28rpx;color:#667e7c;font-size:26rpx;line-height:1.8;white-space:pre-wrap;word-break:break-word}
.room-subtitle:last-child{margin-bottom:0}
.room-translation{margin-top:10rpx;color:#183e43;font-size:38rpx;line-height:1.8;white-space:pre-wrap;word-break:break-word}
.room-qr{display:block;width:336rpx;height:336rpx;margin:0 auto 24rpx;padding:14rpx;border:1px solid #d4e0d9;border-radius:22rpx;background:#fff}
.room-feed{border-top:1px solid #d4e0d9;padding-top:36rpx}
.room-feed-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:24rpx;font-weight:600}
.room-feed-title{font-size:30rpx}.room-feed-heading .room-caption{font-size:20rpx;font-weight:400;white-space:nowrap}
.room-language-group{margin-top:14rpx;padding:22rpx;border-radius:18rpx;background:#edf5ef;font-size:24rpx;font-weight:600}
.room-member-names{margin-top:8rpx;color:#587066;font-size:22rpx;font-weight:400;word-break:break-all}
.room-feed-empty{margin-top:28rpx;color:#7b8a80;font-size:24rpx;line-height:1.8}
.room-feed-item{margin-top:26rpx;padding:26rpx;border:1px solid #d4e0d9;border-radius:22rpx;background:#f8faf9}
.room-feed-source{margin-top:18rpx;padding-bottom:18rpx;border-bottom:1px solid #d4e0d9;color:#7b8a80;font-size:22rpx;line-height:1.7;white-space:pre-wrap;word-break:break-word}
.room-feed-text{margin-top:18rpx;color:#183e43;font-size:30rpx;line-height:1.8;white-space:pre-wrap;word-break:break-word}
.has-error .room-feed-text{color:#a4483b}
.room-playback{padding:16px;border:1px solid #d4e0d9;border-radius:12px;background:#edf5ef}
.room-playback-notice{margin:10px 0;color:#587066;font-size:13px;line-height:1.7}
.room-chat{display:flex;flex-direction:column;height:100vh;overflow:hidden;background:#edf1ee;color:#183e43}
.chat-header{display:flex;align-items:center;gap:20rpx;flex-shrink:0;min-height:144rpx;padding:20rpx 24rpx;border-bottom:1px solid #e0e7e2;background:#f8faf9}
.chat-header-back,.chat-more,.chat-toolbar-more{display:flex;align-items:center;justify-content:center;flex:0 0 88rpx;width:88rpx;height:88rpx;padding:0;border:0;border-radius:24rpx;background:transparent;color:#183e43;font-size:44rpx}
.chat-header-back{font-size:68rpx;font-weight:300}.chat-heading{flex:1;min-width:0;text-align:center}.chat-title{margin-bottom:8rpx;font-size:34rpx;font-weight:600;letter-spacing:1rpx}.chat-subtitle{color:#7b8a80;font-size:22rpx}
.chat-room-bar{display:flex;align-items:center;justify-content:space-between;gap:16rpx;flex-shrink:0;min-height:72rpx;padding:0 36rpx;background:#e5ece6;color:#587066;font-size:22rpx}.chat-room-status{display:flex;align-items:center;gap:12rpx}.chat-room-bar button{min-height:72rpx;padding:0;background:transparent;color:#587066;font-size:22rpx}
.chat-error{flex-shrink:0;padding:18rpx 36rpx;background:#fff0e9;color:#a4483b;font-size:24rpx;line-height:1.6}
.chat-timeline{position:relative;flex:1;min-height:0;overflow:hidden}.chat-conversation{height:100%}.chat-content{padding:36rpx 32rpx 48rpx}.chat-system,.chat-divider{margin-bottom:44rpx;color:#8a9790;font-size:22rpx;line-height:1.7;text-align:center}.chat-divider{margin:44rpx 0 32rpx}
.chat-empty{display:flex;flex-direction:column;align-items:center;max-width:560rpx;margin:120rpx auto;color:#60776d;font-size:26rpx;line-height:1.9;text-align:center}.chat-empty-icon{display:flex;align-items:center;justify-content:center;width:136rpx;height:136rpx;margin-bottom:40rpx;border:1px solid #d4e0d9;border-radius:44rpx;background:#f8faf9;color:#577868}.chat-empty-title{margin-bottom:20rpx;font-size:30rpx;font-weight:500}
.chat-message{display:flex;align-items:flex-start;gap:20rpx;margin-bottom:40rpx}.chat-avatar{display:flex;align-items:center;justify-content:center;flex:0 0 72rpx;width:72rpx;height:72rpx;border-radius:22rpx;font-size:22rpx;font-weight:600}.chat-avatar-guide{background:#183e43;color:#fff}.chat-avatar-translation{border:1px solid #d4e0d9;background:#f8faf9;color:#587066}.chat-message-body{min-width:0;max-width:calc(100% - 132rpx)}
.chat-sender{display:flex;align-items:center;gap:16rpx;margin-bottom:12rpx;color:#7b8a80;font-size:22rpx;line-height:1.5}.chat-language{color:#587066;font-size:20rpx}.chat-bubble{display:inline-block;max-width:100%;padding:22rpx 28rpx;border:1px solid #e0e7e2;border-radius:6rpx 26rpx 26rpx 26rpx;background:#fff;color:#27453e;font-size:30rpx;line-height:1.8;white-space:pre-wrap;word-break:break-word;box-shadow:0 2rpx 4rpx #183e4304}.chat-delivery{margin-top:12rpx;color:#8a9790;font-size:20rpx;line-height:1.6}
.is-self{flex-direction:row-reverse}.is-self .chat-message-body{display:flex;flex-direction:column;align-items:flex-end}.is-self .chat-bubble{border-color:#cfdfd2;border-radius:26rpx 6rpx 26rpx 26rpx;background:#dce9df}.is-self .chat-sender{justify-content:flex-end}.has-error .chat-bubble{color:#a4483b;background:#fff8f5;border-color:#ecd8d1}.has-error .chat-delivery{color:#a4483b}
.chat-end{height:2rpx}.chat-latest{position:absolute;right:32rpx;bottom:28rpx;min-height:72rpx;padding:16rpx 24rpx;border:1px solid #d4e0d9;border-radius:40rpx;background:#fff;color:#183e43;font-size:24rpx;box-shadow:0 6rpx 24rpx #183e4310}
.chat-toolbar{flex-shrink:0;padding:20rpx 28rpx max(28rpx,env(safe-area-inset-bottom));border-top:1px solid #d4e0d9;background:#f8faf9}.chat-toolbar-status{margin-bottom:20rpx;color:#7b8a80;font-size:22rpx;line-height:1.6;text-align:center}.chat-toolbar-actions{display:flex;align-items:center;gap:20rpx}.chat-mode-icon{display:flex;align-items:center;justify-content:center;flex:0 0 60rpx;color:#587066;font-size:30rpx}.chat-talk{flex:1;min-width:0;min-height:92rpx;padding:20rpx 24rpx;border:1px solid #183e43;border-radius:20rpx;background:#183e43;color:#fff;font-size:28rpx;font-weight:500;line-height:1.6}.chat-talk.is-speaking[disabled]{border-color:#cfdfd2;background:#dce9df;color:#345948;opacity:1}.chat-toolbar-more{flex-basis:72rpx;width:72rpx}
.room-details-overlay{position:fixed;inset:0;z-index:20;display:flex;align-items:flex-end}.room-details-mask{position:absolute;inset:0;background:#102a3066}.room-details-sheet{position:relative;display:flex;flex-direction:column;width:100%;max-height:85vh;border:1px solid #d4e0d9;border-bottom:0;border-radius:44rpx 44rpx 0 0;background:#f8faf9;overflow:hidden}.room-details-header{display:flex;align-items:center;justify-content:space-between;flex-shrink:0;padding:32rpx 40rpx;border-bottom:1px solid #d4e0d9;font-size:34rpx;font-weight:600}.room-details-header button{display:flex;align-items:center;justify-content:center;width:80rpx;height:80rpx;padding:0;border-radius:50%;background:#edf1ee;font-size:48rpx;font-weight:400}.room-details-scroll{flex:1;min-height:0;max-height:calc(85vh - 145rpx)}.room-details-content{padding:40rpx 40rpx max(48rpx,env(safe-area-inset-bottom))}.room-invite{display:flex;flex-direction:column;align-items:center;gap:24rpx;padding:20rpx 0 36rpx}.room-invite .room-session-code{margin:0}.room-invite .room-qr{width:320rpx;height:320rpx;margin:0}.room-details-label{margin-bottom:24rpx;font-size:28rpx;font-weight:600}.room-detail-member{display:flex;align-items:center;gap:24rpx;margin:24rpx 0;font-size:26rpx}.room-member-avatar{display:flex;align-items:center;justify-content:center;flex:0 0 76rpx;height:76rpx;border:1px solid #d4e0d9;border-radius:22rpx;background:#edf5ef;font-size:22rpx;font-weight:600}
