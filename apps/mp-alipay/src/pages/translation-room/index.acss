.room-page{min-height:100vh;background:#f8faf9;color:#183e43;padding:24rpx}.room-card{padding:28rpx;margin:24rpx 0;border:1px solid #cbd9d3;border-radius:16rpx}.room-title{font-size:36rpx;font-weight:600;margin-bottom:20rpx}.room-label{display:block;margin-top:20rpx}.room-field{padding:20rpx;border:1px solid #cbd9d3;border-radius:8rpx;margin:12rpx 0}.room-button{margin-top:20rpx;background:#183e43;color:#fff}.room-notice{padding:16rpx;color:#667e7c}.room-error{color:#a52d28}.room-subtitle{margin:24rpx 0;color:#667e7c;white-space:pre-wrap}.room-translation{font-size:36rpx;line-height:1.8;white-space:pre-wrap}.room-qr{width:320rpx;height:320rpx}
