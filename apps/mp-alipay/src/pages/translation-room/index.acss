.room-page{height:100vh;background:#f1f6f3;color:#183e43;padding:32rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.room-header{display:flex;align-items:center;justify-content:space-between;min-height:64rpx;color:#587066;font-size:24rpx}
.room-back{min-height:80rpx;margin:0;padding:12rpx 0;background:transparent;color:#183e43;font-size:26rpx;text-align:left}
.room-intro{display:flex;align-items:center;gap:28rpx;margin:52rpx 0 40rpx}.room-intro-icon{display:flex;align-items:center;justify-content:center;flex:0 0 108rpx;height:108rpx;border:1px solid #d9e5dc;border-radius:38rpx;background:#fcfefd;color:#183e43;box-shadow:0 12rpx 36rpx #183e4307}.room-intro-copy-wrap{flex:1;min-width:0}
.room-page-title{font:600 52rpx/1.3 'Noto Serif SC','Songti SC','STSong',serif;letter-spacing:2rpx}
.room-intro-copy{margin-top:14rpx;color:#75897d;font-size:23rpx;line-height:1.8}
.room-notice{display:flex;align-items:center;gap:14rpx;width:fit-content;max-width:100%;margin-bottom:36rpx;padding:14rpx 22rpx;border:1px solid #d9e5dc;border-radius:20rpx;background:#eaf2ed;color:#536f62;font-size:21rpx;line-height:1.7;box-sizing:border-box}
.room-status-dot{flex:0 0 12rpx;width:12rpx;height:12rpx;border-radius:50%;background:#6b8d7c}
.room-card{padding:40rpx;margin-bottom:32rpx;border:1px solid #d9e5dc;border-radius:44rpx;background:#fcfefd;box-shadow:0 20rpx 60rpx #183e4307}
.room-card-heading{display:flex;align-items:center;gap:22rpx;margin-bottom:36rpx;padding-bottom:32rpx;border-bottom:1px solid #e5ede7}
.room-card-icon{display:flex;align-items:center;justify-content:center;flex:0 0 78rpx;width:78rpx;height:78rpx;border-radius:24rpx;background:#edf5ef;color:#183e43}
.room-headphones-icon{position:relative;box-sizing:border-box;width:36rpx;height:34rpx;border:4rpx solid currentColor;border-bottom:0;border-radius:22rpx 22rpx 0 0}
.room-headphones-icon::before,.room-headphones-icon::after{position:absolute;bottom:-2rpx;width:8rpx;height:18rpx;border-radius:4rpx;background:currentColor;content:''}
.room-headphones-icon::before{left:-4rpx}.room-headphones-icon::after{right:-4rpx}
.room-heading-copy{flex:1;min-width:0}
.room-title{font-size:34rpx;font-weight:600;line-height:1.4}
.room-description{margin-top:8rpx;color:#7b8a80;font-size:22rpx;line-height:1.6}
.room-field-group{margin-bottom:40rpx}
.room-label{margin-bottom:18rpx;color:#2b4039;font-size:24rpx;font-weight:600}
.room-code-input{box-sizing:border-box;width:100%;height:116rpx;padding:22rpx 28rpx;border:1px solid #d9e5dc;border-radius:28rpx;background:#f3f7f4;color:#183e43;font-size:50rpx;font-weight:600;letter-spacing:9rpx;text-align:center}
.room-code-placeholder{color:#91a39a;font-size:28rpx;font-weight:400;letter-spacing:2rpx}
.room-language-options{display:flex;flex-wrap:wrap;justify-content:space-between;gap:14rpx}
.room-language-option{box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;width:calc(50% - 7rpx);min-height:88rpx;margin:0;padding:20rpx 22rpx;border:1px solid #d9e5dc;border-radius:24rpx;background:#f5f8f6;color:#587363;font-size:25rpx;font-weight:400}
.room-language-option.is-selected{border-color:#183e43;background:#e8f2ec;color:#183e43;font-weight:600}
.room-action{box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:18rpx;width:100%;min-height:94rpx;margin:24rpx 0 0;padding:24rpx 28rpx;border:1px solid #d9e5dc;border-radius:28rpx;background:#f1f6f3;color:#183e43;font-size:25rpx;font-weight:600;line-height:1.6}
.room-action-primary{border-color:#183e43;background:#183e43;color:#fff;box-shadow:0 8rpx 22rpx #183e4318}
.room-action-danger{border-color:#ecd8d1;background:#fff8f5;color:#a4483b}
.room-action-quiet{border-color:transparent;background:transparent;color:#667e7c}
.room-scan{min-height:72rpx;margin:-18rpx 0 36rpx;padding:14rpx 24rpx;background:#edf5ef;font-size:24rpx;font-weight:400}
.room-help{margin-top:20rpx;color:#7b8a80;font-size:21rpx;line-height:1.7;text-align:center}
.room-error{padding:22rpx 26rpx;margin-bottom:32rpx;border:1px solid #ecd8d1;border-radius:22rpx;background:#fff8f5;color:#a4483b;font-size:24rpx;line-height:1.6}
.room-session-heading{text-align:center;margin-bottom:36rpx}
.room-caption{color:#7b8a80;font-size:22rpx;line-height:1.6}
.room-session-code{margin-top:14rpx;color:#183e43;font-size:56rpx;font-weight:600;letter-spacing:9rpx;word-break:break-all}
.room-members{margin:20rpx 0;color:#587066;font-size:24rpx;line-height:1.7}
.room-transcript{margin:36rpx 0;padding:28rpx;border-radius:22rpx;background:#fcfefd}
.room-subtitle{margin:10rpx 0 28rpx;color:#667e7c;font-size:26rpx;line-height:1.8;white-space:pre-wrap;word-break:break-word}
.room-subtitle:last-child{margin-bottom:0}
.room-translation{margin-top:10rpx;color:#183e43;font-size:38rpx;line-height:1.8;white-space:pre-wrap;word-break:break-word}
.room-qr{display:block;width:336rpx;height:336rpx;margin:0 auto 24rpx;padding:14rpx;border:1px solid #d9e5dc;border-radius:22rpx;background:#fff}
.room-feed{border-top:1px solid #d9e5dc;padding-top:36rpx}
.room-feed-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:24rpx;font-weight:600}
.room-feed-title{font-size:30rpx}.room-feed-heading .room-caption{font-size:20rpx;font-weight:400;white-space:nowrap}
.room-language-group{margin-top:14rpx;padding:22rpx;border-radius:18rpx;background:#edf5ef;font-size:24rpx;font-weight:600}
.room-member-names{margin-top:8rpx;color:#587066;font-size:22rpx;font-weight:400;word-break:break-all}
.room-feed-empty{margin-top:28rpx;color:#7b8a80;font-size:24rpx;line-height:1.8}
.room-feed-item{margin-top:26rpx;padding:26rpx;border:1px solid #d9e5dc;border-radius:22rpx;background:#fcfefd}
.room-feed-source{margin-top:18rpx;padding-bottom:18rpx;border-bottom:1px solid #d9e5dc;color:#7b8a80;font-size:22rpx;line-height:1.7;white-space:pre-wrap;word-break:break-word}
.room-feed-text{margin-top:18rpx;color:#183e43;font-size:30rpx;line-height:1.8;white-space:pre-wrap;word-break:break-word}
.has-error .room-feed-text{color:#a4483b}
.room-playback{padding:16px;border:1px solid #d9e5dc;border-radius:12px;background:#edf5ef}
.room-playback-notice{margin:10px 0;color:#587066;font-size:13px;line-height:1.7}
.room-chat{box-sizing:border-box;display:flex;flex-direction:column;height:100vh;max-width:1280rpx;margin:0 auto;overflow:hidden;background:#f1f6f3;color:#183e43}
.chat-header{box-sizing:border-box;display:flex;align-items:center;gap:16rpx;flex-shrink:0;min-height:148rpx;padding:20rpx 24rpx;border-bottom:1px solid #d9e5dc;background:#fcfefd}
.chat-header-back,.chat-more,.chat-toolbar-more{display:flex;align-items:center;justify-content:center;flex:0 0 76rpx;width:76rpx;height:84rpx;margin:0;padding:0;border:0;border-radius:24rpx;background:#f0f5f2;color:#183e43;font-size:42rpx}
.chat-header-back{flex-basis:64rpx;width:64rpx;font-size:64rpx;font-weight:300}.chat-room-icon{display:flex;align-items:center;justify-content:center;flex:0 0 78rpx;height:78rpx;border:1px solid #d9e5dc;border-radius:28rpx;background:#eaf2ed}.chat-heading{flex:1;min-width:0;text-align:left}.chat-title{margin-bottom:8rpx;font:600 35rpx/1.4 'Noto Serif SC','Songti SC','STSong',serif}.chat-subtitle{color:#75897d;font-size:20rpx;line-height:1.6}.chat-more{background:transparent}
.chat-room-bar{display:flex;align-items:center;justify-content:space-between;gap:20rpx;flex-shrink:0;min-height:84rpx;padding:0 40rpx;border-bottom:1px solid #d9e5dc;background:#eaf2ed;color:#587363;font-size:21rpx}.chat-room-status{display:flex;align-items:center;gap:14rpx}.chat-room-bar.is-live .room-status-dot{background:#367a68;box-shadow:0 0 0 6rpx #367a6814}.chat-room-bar button{min-height:84rpx;margin:0;padding:0;background:transparent;color:#587363;font-size:21rpx}
.chat-error{flex-shrink:0;padding:18rpx 36rpx;background:#fff0e9;color:#a4483b;font-size:24rpx;line-height:1.6}
.chat-timeline{position:relative;flex:1;min-height:0;overflow:hidden}.chat-conversation{height:100%}.chat-content{padding:32rpx 32rpx 48rpx}.chat-system{margin-bottom:40rpx;color:#8b9e90;font-size:20rpx;line-height:1.8;text-align:center}.chat-divider{display:flex;align-items:center;gap:20rpx;margin:40rpx 0 22rpx;color:#8b9e90;font-size:20rpx;line-height:1.6}.chat-divider:after{flex:1;height:1px;background:#dce7df;content:""}
.chat-empty{display:flex;flex-direction:column;align-items:center;max-width:540rpx;margin:100rpx auto;color:#688171;font-size:24rpx;line-height:1.9;text-align:center}.chat-empty-icon{display:flex;align-items:center;justify-content:center;width:138rpx;height:138rpx;margin-bottom:38rpx;border:1px solid #d9e5dc;border-radius:46rpx;background:#fcfefd;color:#367a68}.chat-empty-title{margin-bottom:20rpx;color:#436354;font:600 36rpx/1.6 'Songti SC','STSong',serif}
.chat-message{display:flex;align-items:flex-start;gap:16rpx;margin-bottom:36rpx}.chat-avatar{display:flex;align-items:center;justify-content:center;flex:0 0 52rpx;width:52rpx;height:56rpx;border-radius:18rpx;background:#183e43;color:#fff;font-size:24rpx}.chat-message-body{flex:1;min-width:0;max-width:calc(100% - 68rpx)}
.chat-sender{margin-bottom:14rpx;color:#75897d;font-size:20rpx;line-height:1.5}.chat-language{display:table;margin-bottom:12rpx;padding:4rpx 12rpx;border:1px solid #dce8df;border-radius:12rpx;background:#edf4ef;color:#688171;font-size:20rpx;line-height:1.5}.chat-bubble{box-sizing:border-box;width:100%;padding:28rpx 30rpx;border:1px solid #d9e5dc;border-radius:8rpx 38rpx 38rpx 38rpx;background:#fcfefd;color:#294b3d;font-size:29rpx;line-height:1.85;white-space:pre-wrap;word-break:break-word;box-shadow:0 8rpx 28rpx #183e4304}.chat-delivery{margin-top:14rpx;color:#8b9e90;font-size:20rpx;line-height:1.7}
.is-self .chat-avatar{background:#367a68}.is-self .chat-bubble{border-color:#cfe1d5;background:#f7fbf8}.has-error .chat-bubble{color:#a05c4c;background:#fff7f3;border-color:#ecdcd5}.has-error .chat-delivery{color:#a05c4c}
.chat-end{height:2rpx}.chat-latest{position:absolute;right:32rpx;bottom:28rpx;min-height:72rpx;padding:16rpx 24rpx;border:1px solid #d9e5dc;border-radius:40rpx;background:#fff;color:#183e43;font-size:24rpx;box-shadow:0 6rpx 24rpx #183e4310}
.chat-bilingual{white-space:normal}.chat-message-text{white-space:pre-wrap;word-break:break-word}.chat-translation+.chat-translation,.chat-source{margin-top:30rpx;padding-top:26rpx;border-top:1px solid #e2ebe5}.chat-source:first-child{margin-top:0;padding-top:0;border-top:0}.chat-source{color:#75897d;font-size:24rpx;line-height:1.8}.chat-source .chat-language{padding:0;border:0;background:transparent;color:#8b9e90}.has-error .chat-message-text{color:#a05c4c}
.chat-toolbar{flex-shrink:0;padding:24rpx 32rpx max(32rpx,env(safe-area-inset-bottom));border-top:1px solid #d9e5dc;background:#fcfefd;box-shadow:0 -12rpx 60rpx #183e4304}.chat-toolbar-status{margin-bottom:20rpx;color:#75897d;font-size:21rpx;line-height:1.7;text-align:center}.chat-toolbar-actions{display:flex;align-items:center;gap:20rpx}.chat-mode-icon{display:flex;align-items:center;justify-content:center;flex:0 0 84rpx;height:94rpx;border:1px solid #d9e5dc;border-radius:28rpx;background:#eaf2ed;color:#367a68;font-size:30rpx}.chat-talk{flex:1;min-width:0;min-height:96rpx;margin:0;padding:24rpx;border:1px solid #183e43;border-radius:28rpx;background:#183e43;color:#fff;font-size:27rpx;font-weight:500;line-height:1.6}.chat-talk.is-speaking[disabled]{border-color:#cfe1d5;background:#e0eee5;color:#367a68;opacity:1}.chat-toolbar-more{height:94rpx}
.room-details-overlay{position:fixed;inset:0;z-index:20;display:flex;align-items:flex-end}.room-details-mask{position:absolute;inset:0;background:#102a3066}.room-details-sheet{position:relative;display:flex;flex-direction:column;width:100%;max-height:85vh;border:1px solid #d9e5dc;border-bottom:0;border-radius:52rpx 52rpx 0 0;background:#fcfefd;overflow:hidden}.room-details-header{display:flex;align-items:center;justify-content:space-between;flex-shrink:0;padding:32rpx 40rpx;border-bottom:1px solid #d9e5dc;font-size:34rpx;font-weight:600}.room-details-header button{display:flex;align-items:center;justify-content:center;width:80rpx;height:80rpx;padding:0;border-radius:50%;background:#edf1ee;font-size:48rpx;font-weight:400}.room-details-scroll{flex:1;min-height:0;max-height:calc(85vh - 145rpx)}.room-details-content{padding:40rpx 40rpx max(48rpx,env(safe-area-inset-bottom))}.room-invite{display:flex;flex-direction:column;align-items:center;gap:24rpx;padding:40rpx 24rpx;border:1px solid #d9e5dc;border-radius:40rpx;background:#f1f6f3}.room-invite .room-session-code{margin:0}.room-invite .room-qr{width:320rpx;height:320rpx;margin:0}.room-details-label{margin-bottom:24rpx;font-size:28rpx;font-weight:600}.room-detail-member{display:flex;align-items:center;gap:24rpx;margin:24rpx 0;font-size:26rpx}.room-member-avatar{display:flex;align-items:center;justify-content:center;flex:0 0 76rpx;height:76rpx;border:1px solid #d9e5dc;border-radius:22rpx;background:#edf5ef;font-size:22rpx;font-weight:600}
