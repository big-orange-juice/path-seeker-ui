.photo { width: 100%; height: 300rpx; margin: 20rpx 0; }.postcard-row { display: block; width: 100%; text-align: left; }.postcard-overlay { position: fixed; inset: 0; z-index: 80; display: flex; align-items: center; justify-content: center; padding: 24rpx; background: #183e4377; }.postcard-detail { width: 100%; max-height: 90vh; overflow: auto; }.postcard-result { display: block; width: 100%; margin: 16rpx 0; }
