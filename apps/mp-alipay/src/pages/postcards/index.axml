<scroll-view scroll-y="true" class="full-page"><view class="page"><view class="eyebrow">PATH SEEKER · 电子明信片</view><view class="title">{{composer ? '留下这一站' : '我的旅行记忆'}}</view>
  <view a:if="{{error}}" class="error">{{error}}<button size="mini" onTap="load">重试</button></view><view a:if="{{loading}}" class="muted">加载中…</view>
  <view a:if="{{!eligible && !loading}}" class="card"><view class="subtitle">授权手机号后，制作并保存属于你的电子明信片。</view><button class="primary" onTap="authorize">授权手机号</button></view>
  <block a:if="{{eligible}}"><view a:if="{{composer && experience}}" class="card"><picker range="{{templates}}" range-key="name" value="{{templateIndex}}" onChange="template" disabled="{{busy || result && result.status != 'failed'}}"><view class="field">{{templates[templateIndex].name}} ▾</view></picker><button disabled="{{busy || result && result.status != 'failed'}}" onTap="choosePhoto">{{experience.mode === 'ai' ? '选择照片，生成旅程纪念' : '使用自己的照片（可选）'}}</button><image a:if="{{photoPath}}" src="{{photoPath}}" class="photo" mode="aspectFit"/><textarea class="field" value="{{caption}}" maxlength="160" placeholder="留一句话，寄给自己（可选）" onInput="caption" disabled="{{busy || result && result.status != 'failed'}}"/><view a:if="{{result}}" class="muted">{{result.status === 'completed' ? '已收入我的电子明信片' : result.status === 'failed' ? result.error : '正在制作，可以稍后在我的中查看'}}</view><button a:if="{{!result || result.status === 'failed'}}" class="primary" onTap="generate" disabled="{{busy}}" loading="{{busy}}">{{result ? '重新生成' : '生成电子明信片'}}</button></view>
  <block a:else><button class="quiet" onTap="view">{{albumView ? '查看全部明信片' : '按路线查看旅行册'}}</button><view a:if="{{!cards.length && !loading}}" class="card muted">还没有明信片。在开放制作的景点，留下你的第一张。</view><block a:if="{{albumView}}"><view a:for="{{albums}}" a:key="id" class="card"><view class="section">{{item.title}} · {{item.cards.length}} 张</view><button a:for="{{item.cards}}" a:for-item="card" a:key="id" data-id="{{card.id}}" onTap="open">{{card.stageTitle}} →</button></view></block><block a:else><button a:for="{{cards}}" a:key="id" class="card postcard-row" data-id="{{item.id}}" onTap="open"><view class="section">{{item.stageTitle}}</view><view class="muted">{{item.routeTitle}} · {{item.status === 'completed' ? '查看明信片' : '查看生成进度'}}</view></button></block><view a:if="{{albumView && cards.length < total}}" class="muted">继续加载可补齐旅行册中的历史明信片。</view><button a:if="{{cards.length < total}}" onTap="more" disabled="{{loading}}">加载更多</button></block></block>
  <view a:if="{{selected}}" class="postcard-overlay"><view class="card postcard-detail"><view class="row between"><view class="section">{{selected.stageTitle}}</view><button size="mini" class="quiet" onTap="closeCard">关闭 ×</button></view><image a:if="{{imagePath}}" src="{{imagePath}}" class="postcard-result" mode="widthFix"/><view a:else class="muted">{{selected.error || '图片正在准备中，稍后重新打开查看。'}}</view><button a:if="{{selected.status != 'completed'}}" onTap="refreshCard">刷新进度</button><button a:if="{{imagePath}}" class="primary" onTap="saveImage">保存图片</button></view></view>
</view></scroll-view>
