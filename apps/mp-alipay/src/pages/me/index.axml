<scroll-view scroll-y="true" class="full-page"><view class="page"><view class="eyebrow">PATH SEEKER · 我的寻迹</view><view class="title">把故事，留在途中。</view>
  <view a:if="{{error}}" class="error">{{error}}<button size="mini" onTap="load">重试</button></view><view a:if="{{loading}}" class="muted">正在加载…</view>
  <view class="card"><view class="row"><image a:if="{{profile.avatarUrl || user.avatarUrl}}" class="avatar" src="{{profile.avatarUrl || user.avatarUrl}}" mode="aspectFill"/><view a:else class="avatar avatar-letter">迹</view><view class="grow"><view class="name">{{profile.nickname || user.nickname || '漫游者'}}</view><view class="muted">{{user.isGuest ? '游客身份' : '寻迹账号'}} · {{user.userNo || ''}}</view></view></view><view class="actions"><button a:if="{{user.isGuest}}" class="primary" onTap="login">授权登录</button><button a:else onTap="logout">退出登录</button><button onTap="edit">编辑资料</button></view>
    <view a:if="{{editing}}"><input class="field" value="{{nickname}}" data-field="nickname" onInput="input" placeholder="昵称" maxlength="64"/><input class="field" value="{{country}}" data-field="country" onInput="input" placeholder="国家 / 地区" maxlength="64"/><button class="primary save" disabled="{{busy}}" onTap="save">保存资料</button></view>
  </view>
  <view class="card"><view class="section">我的旅程</view><button class="link-row" onTap="postcards">电子明信片与旅行册 <text>›</text></button><button class="link-row" onTap="tour">继续漫游 <text>›</text></button><button class="link-row" onTap="records">行程记录与足迹 <text>›</text></button></view>
  <view class="card"><view class="section">偏好设置</view><picker range="{{locales}}" range-key="label" value="{{localeIndex}}" onChange="locale"><view class="link-row">讲解语言 <text>{{locales[localeIndex].label}} ▾</text></view></picker><view class="subtitle">问答音色</view><input class="field" value="{{voiceId}}" data-field="voiceId" onInput="input" placeholder="填写音色 ID，留空跟随当前讲解员" maxlength="256"/><button class="save" onTap="saveVoice">保存音色</button></view>
  <view class="card"><button class="link-row" onTap="privacy">隐私说明与权限 <text>›</text></button><button class="link-row" onTap="clearHistory">清除本机漫游记录 <text>›</text></button></view>
</view></scroll-view>
