<scroll-view scroll-y="true" class="full-page"><view class="page auth-page"><view class="eyebrow">PATH SEEKER · 寻迹</view><view class="title">{{register ? '让足迹有个归处' : '欢迎回来'}}。</view><view class="subtitle">登录后，继续你的城市漫游。</view><view class="card">
  <view class="section">支付宝授权登录</view>
  <view class="subtitle">{{postcardPhone ? '授权手机号，将电子明信片保存到你的账号。' : requirePhoneNumber ? '授权手机号以登录寻迹，并识别已有的车夫权限。' : '使用支付宝登录，加入房间体验语音翻译。'}}</view>
  <view class="agreement"><checkbox-group onChange="agree"><label class="row"><checkbox value="agree" checked="{{agreed}}"/><text class="muted">我已阅读并同意隐私说明</text></label></checkbox-group><button size="mini" class="quiet" onTap="privacy">查看隐私说明</button></view>
  <view a:if="{{error}}" class="error">{{error}}</view><button a:if="{{requirePhoneNumber}}" class="primary" loading="{{busy}}" disabled="{{busy || !agreed}}" open-type="getAuthorize" scope="phoneNumber" onGetAuthorize="alipay" onError="alipayError">手机号授权登录</button>
  <button a:else class="primary" loading="{{busy}}" disabled="{{busy || !agreed}}" onTap="alipay">支付宝授权登录</button>
  <block a:if="{{passwordLoginEnabled}}">
  <view class="section account-section">{{register ? '创建寻迹账号' : '已有寻迹账号登录'}}</view>
  <input a:if="{{!register}}" class="field" value="{{account}}" data-field="account" onInput="input" placeholder="用户名 / 手机号 / 邮箱" maxlength="256"/>
  <block a:else><input class="field" value="{{username}}" data-field="username" onInput="input" placeholder="用户名（与手机号、邮箱任选一项）" maxlength="64"/><input class="field" value="{{phone}}" data-field="phone" onInput="input" placeholder="手机号" maxlength="32"/><input class="field" value="{{email}}" data-field="email" onInput="input" placeholder="邮箱" maxlength="256"/><input class="field" value="{{nickname}}" data-field="nickname" onInput="input" placeholder="昵称（选填）" maxlength="64"/></block>
  <input class="field" value="{{password}}" data-field="password" onInput="input" password="true" placeholder="{{register ? '设置密码（至少 6 位）' : '密码'}}" maxlength="128"/>
  <button loading="{{busy}}" disabled="{{busy}}" onTap="submit">{{register ? '注册并登录' : '账号密码登录'}}</button><button class="quiet" disabled="{{busy}}" onTap="mode">{{register ? '已有账号，去登录' : '创建新账号'}}</button>
  </block>
  </view><button a:if="{{guestLoginEnabled}}" class="quiet" disabled="{{busy}}" onTap="guest">先以游客身份漫游</button></view></scroll-view>
