<view class="story-body">
  <button a:if="{{stop.experience && stop.experience.enabled}}" class="primary" onTap="postcard" disabled="{{busy || loading}}">制作电子明信片</button>
  <view a:if="{{browsing}}" class="story-alert">{{messages.browsingNoProgress}}</view>
  <view a:if="{{stop.images.length}}" class="story-carousel">
    <swiper class="story-image-swiper" current="{{imageIndex || 0}}" onChange="changeImage" autoplay="{{false}}" circular="{{false}}">
      <swiper-item a:for="{{stop.images}}" a:key="id"><image class="story-carousel-image" src="{{item.url}}" mode="aspectFit" data-index="{{index}}" onTap="previewImages" aria-label="{{item.altText || stop.name}}" /></swiper-item>
    </swiper>
    <view a:if="{{stop.images.length > 1}}" class="story-image-navigation"><button size="mini" onTap="previousImage" disabled="{{!imageIndex}}" aria-label="{{messages.previousImage}}">‹</button><text>{{(imageIndex || 0) + 1}} / {{stop.images.length}}</text><button size="mini" onTap="nextImage" disabled="{{imageIndex >= stop.images.length - 1}}" aria-label="{{messages.nextImage}}">›</button></view>
    <view a:if="{{stop.images[imageIndex || 0].caption}}" class="story-image-caption">{{stop.images[imageIndex || 0].caption}}</view>
  </view>
  <view class="story-controls">
    <button class="primary grow" onTap="togglePlay" disabled="{{busy || loading || !canPlayStop}}">{{playingStopId && playingStopId !== stop.id ? messages.enterStopPlay : playing ? messages.pause : paused ? messages.resume : messages.play}}</button>
    <button onTap="replay" disabled="{{busy || loading || !canPlayStop || playingStopId && playingStopId !== stop.id}}">{{messages.replayStop}}</button>
    <view class="seek-controls">
      <button size="mini" onTap="backAudio" disabled="{{busy || loading || !playingStopId || playingStopId !== stop.id}}">{{messages.rewind15}}</button>
      <button size="mini" onTap="forwardAudio" disabled="{{busy || loading || !playingStopId || playingStopId !== stop.id}}">{{messages.forward15}}</button>
    </view>
    <picker a:if="{{guides.length > 1}}" range="{{guides}}" range-key="guideName" value="{{guideIndex}}" onChange="chooseGuide"><view class="field">{{messages.guide}}：{{guides[guideIndex].guideName}} ▾</view></picker>
  </view>
  <view a:if="{{hasDuration}}" class="playback-status"><text>{{messages.playbackProgress}}：{{timeLabel}} / {{durationLabel}}</text></view>
  <view a:if="{{itemTitle}}" class="playback-status"><text>{{messages.playingNow}}：{{itemTitle}}</text></view>
  <slider value="{{progress}}" min="0" max="100" activeColor="#183e43" onChange="seek" disabled="{{busy || loading || !playingStopId || playingStopId !== stop.id}}" />
  <view a:if="{{audioError}}" class="error">{{audioError}}</view>
  <view a:if="{{stop.arrivalNote}}" class="arrival-note">{{stop.arrivalNote}}</view>
  <view a:for="{{chapters}}" a:key="id" class="chapter"><view a:if="{{item.title}}" class="section">{{item.title}}</view><text class="story">{{item.text}}</text></view>
  <view a:if="{{!chapters.length}}" class="empty">{{messages.noNarration}}</view>
  <button a:if="{{stop.video}}" class="story-video-button" onTap="playStopVideo" disabled="{{busy || loading}}">▶ {{messages.video}}</button>
</view>
