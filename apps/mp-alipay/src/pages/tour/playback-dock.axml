<view a:if="{{stop}}" class="tour-playback-dock">
  <view class="dock-modes">
    <button class="dock-room" onTap="translationRoom"><view class="dock-mode-content"><view class="dock-headphones-icon"/><text>{{hasTranslationRoom ? messages.commentaryRoom : messages.liveCommentary}}</text><view a:if="{{hasTranslationRoom}}" class="dock-live-dot"/></view></button>
    <button class="dock-now {{screenOffListening ? 'is-active' : ''}}" onTap="toggleScreenOffListening" aria-pressed="{{screenOffListening}}" aria-label="息屏收听"><view class="dock-mode-content"><text>息屏收听</text><view class="dock-switch"><view/></view></view></button>
    <button class="dock-nearby {{locationEnabled ? 'is-active' : ''}}" onTap="toggleTracking" disabled="{{busy || loading}}" aria-pressed="{{locationEnabled}}" aria-label="{{locationEnabled ? messages.stopLocate : messages.locate}}"><view class="dock-mode-content"><text>{{locationEnabled ? messages.locationReady : messages.locate}}</text><view class="dock-switch"><view/></view></view></button>
  </view>
  <view a:if="{{locationEnabled || locationNote === messages.driverRoomRequired}}" class="dock-location-note" role="status">{{locationNote}}</view>
  <view class="dock-main">
    <view a:if="{{driverManaged}}" class="dock-play follow-wave {{playing ? 'is-playing' : ''}}" role="status" aria-label="{{followStatus}}" catchTap="ignorePlaybackTap"><view/><view/><view/><view/><view/></view>
    <button a:else class="dock-play" onTap="togglePlay" disabled="{{busy || loading || !canPlayStop}}" aria-label="{{playing ? messages.pause : paused ? messages.resume : messages.play}}"><view class="{{playing ? 'dock-pause-icon' : 'dock-play-icon'}}"/></button>
    <button class="dock-story" onTap="openContent" aria-label="{{messages.content}}"><view class="dock-caption">{{stopIndex + 1}} / {{stops.length}} · {{playing ? messages.playingNow : messages.content}}</view><view class="dock-story-title">{{stop.name}}</view><view a:if="{{itemTitle}}" class="dock-item-title">{{itemTitle}}</view></button>
    <button class="dock-queue {{queueOpen ? 'is-active' : ''}}" onTap="toggleQueue" disabled="{{!!videoItem}}" aria-label="{{messages.queueTitle}}"><view class="dock-list-icon"><view/><view/><view/></view><text>{{queuedCount}}</text></button>
  </view>
  <view a:if="{{driverManaged}}" class="follow-listening" catchTap="ignorePlaybackTap"><text>{{followStatus || '讲解尚未连接'}}</text><text class="follow-help">关闭跟随车夫后可手动播放</text><text a:if="{{audioLag > 5}}" class="follow-help">播放缓冲约 {{audioLag}} 秒</text><button a:if="{{audioError || paused}}" size="mini" onTap="retryAudio" disabled="{{audioRecovering || audioCreating}}">重新连接</button></view>
  <view a:else class="dock-timeline"><text>{{timeLabel}}</text><slider value="{{progress}}" onChange="seek" min="0" max="100" step="0.1" block-size="10" active-color="#3f7e6f" background-color="#dfe9e3" disabled="{{!hasDuration || busy || loading}}" aria-label="{{messages.playbackProgress}}"/><text>{{durationLabel}}</text></view>
  <view a:if="{{!driverManaged}}" class="dock-transport"><button onTap="previous" disabled="{{busy || loading || stopIndex <= 0}}" aria-label="{{messages.prevStop}}"><text>‹</text>{{messages.prevStop}}</button><button onTap="backAudio" disabled="{{busy || loading || !hasDuration}}" aria-label="{{messages.rewind15}}">↶ 15</button><button onTap="forwardAudio" disabled="{{busy || loading || !hasDuration}}" aria-label="{{messages.forward15}}">15 ↷</button><button onTap="next" disabled="{{busy || loading || stopIndex >= stops.length - 1}}" aria-label="{{messages.nextStop}}">{{messages.nextStop}}<text>›</text></button></view>
</view>
