<view class="tour-page">
  <map id="tour-map" class="map" longitude="{{map.longitude}}" latitude="{{map.latitude}}" scale="15" markers="{{map.markers}}" polyline="{{map.polyline}}" include-points="{{map.includePoints}}" show-location="{{locationEnabled}}" optimize="true" onMarkerTap="marker" onCalloutTap="marker" />
  <view class="map-actions row between"><text class="muted grow">{{route ? route.title : '在城市里，寻找故事'}}</text><view class="row"><button size="mini" onTap="overview">{{messages.overview}}</button><button size="mini" onTap="recenter" disabled="{{!locationEnabled}}">{{messages.follow}}</button></view></view>
  <scroll-view class="panel" scroll-y="true">
    <view class="page">
      <view class="eyebrow">PATH SEEKER · 城市漫游</view>
      <view class="title">沿途，听见故事</view>
      <view class="row selectors"><picker range="{{destinations}}" range-key="name" value="{{destinationIndex}}" onChange="chooseDestination"><view class="pill">{{(destinations[destinationIndex] &amp;&amp; destinations[destinationIndex].name) || '全部目的地'}} ▾</view></picker><picker range="{{locales}}" range-key="label" value="{{localeIndex}}" onChange="chooseLocale"><view class="pill">{{locales[localeIndex].label}} ▾</view></picker></view>
      <input class="field" placeholder="{{messages.search}}" value="{{search}}" onInput="search" />
      <view a:if="{{error}}" class="error">{{error}}<button size="mini" onTap="retry">{{messages.retry}}</button></view>
      <view a:if="{{loading}}" class="muted">{{messages.loading}}</view>
      <scroll-view class="route-list" scroll-x="true"><view class="route-row"><view a:for="{{routes}}" a:key="id" class="route-card {{route &amp;&amp; route.id === item.id ? 'selected' : ''}}" data-id="{{item.id}}" onTap="chooseRoute"><image a:if="{{item.cover}}" class="route-cover" src="{{item.cover}}" mode="aspectFill"/><view class="route-name">{{item.title}}</view><view class="muted">{{item.durationMinutes || '—'}} 分钟 · {{item.stopCount || 0}} 站</view></view></view></scroll-view>
      <view a:if="{{!loading &amp;&amp; !routes.length}}" class="empty">{{messages.noRoutes}}</view>
      <block a:if="{{route}}">
        <view class="section">{{route.title}}</view><view class="muted">{{route.subtitle || route.description}}</view>
        <view class="actions"><button class="primary" disabled="{{busy || loading || !stops.length}}" onTap="startVisit">{{visit &amp;&amp; visit.status === 1 ? messages.resume : messages.start}}</button><button a:if="{{visit &amp;&amp; visit.status === 1}}" disabled="{{busy || loading}}" onTap="endVisit">{{messages.end}}</button></view>
        <view a:if="{{visit}}" class="subtitle">已完成 {{(visit.completedStageIds &amp;&amp; visit.completedStageIds.length) || 0}} / {{stops.length}} 站</view>
        <view class="stop-list"><view a:for="{{stops}}" a:key="id" class="stop-row {{stopIndex === index ? 'selected' : ''}}" data-index="{{index}}" onTap="browse"><text class="stop-number">{{index + 1}}</text><text class="grow">{{item.name}}</text><text class="muted">查看 ›</text></view></view>
        <view a:if="{{stop}}" class="card">
          <view class="row between"><text class="pill">{{browsing ? '站点浏览' : '当前行程站点'}}</text><text class="muted">{{stopIndex + 1}} / {{stops.length}}</text></view>
          <view class="section">{{stop.name}}</view><view class="muted">{{stop.arrivalNote}}</view>
          <image a:if="{{stop.images.length}}" class="stop-cover" src="{{stop.images[0].url}}" mode="aspectFill" onTap="previewImages" />
          <video a:if="{{stop.video}}" src="{{stop.video}}" controls="true" class="stop-video" />
          <picker a:if="{{guides.length}}" range="{{guides}}" range-key="guideName" value="{{guideIndex}}" onChange="chooseGuide"><view class="field">讲解员：{{guides[guideIndex].guideName}} ▾</view></picker>
          <view a:if="{{itemTitle}}" class="subtitle">正在讲解 · {{itemTitle}}</view>
          <view class="row audio-actions"><button size="mini" onTap="backAudio">{{messages.rewind15}}</button><button class="primary grow" onTap="togglePlay" disabled="{{busy || loading}}">{{playing ? messages.pause : messages.play}}</button><button size="mini" onTap="forwardAudio">{{messages.forward15}}</button></view>
          <slider value="{{progress}}" min="0" max="100" activeColor="#183e43" onChange="seek"/><view class="row between muted"><text>{{timeLabel}}</text><text>{{durationLabel}}</text></view>
          <view a:if="{{audioError}}" class="error">{{audioError}}</view>
          <view class="actions"><button onTap="replay" disabled="{{busy || loading}}">{{messages.replayStop}}</button><button onTap="ask">{{messages.ask}}</button><button a:if="{{browsing}}" disabled="{{busy || loading}}" onTap="enterCurrent">{{messages.enterStopPlay}}</button><button a:else class="primary" disabled="{{busy || loading}}" onTap="manualComplete">{{messages.complete}}</button></view>
          <view class="row between navigation"><button disabled="{{stopIndex === 0 || busy || loading}}" onTap="previous">{{messages.prevStop}}</button><button disabled="{{stopIndex + 1 >= stops.length || busy || loading}}" onTap="next">{{messages.nextStop}}</button></view>
          <view a:for="{{chapters}}" a:key="id" class="chapter"><view class="section">{{item.title}}</view><text class="story">{{item.text}}</text></view>
          <view a:if="{{!chapters.length}}" class="empty">{{messages.noNarration}}</view>
          <view a:if="{{stop.extraAudios &amp;&amp; stop.extraAudios.length}}" class="section">{{messages.extraAudio}}</view>
          <view a:for="{{stop.extraAudios}}" a:key="id" class="row extra-row"><text class="muted grow">{{item.position === 'before' ? messages.beforeAudio : messages.afterAudio}} · {{item.title}}</text><button size="mini" data-id="{{item.id}}" onTap="playExtra" disabled="{{busy || loading || !item.url}}">{{messages.play}}</button></view>
        </view>
        <view class="card stack"><view class="row between"><text class="grow">{{messages.queueAutoPlay}}</text><switch checked="{{autoplay}}" onChange="changeAutoplay" color="#183e43"/></view><view class="row between"><text class="grow">{{messages.queueLockContent}}</text><switch checked="{{lockContent}}" onChange="changeLock" color="#183e43"/></view><view class="row between"><text class="grow">{{messages.skipExtraAudio}}</text><switch checked="{{skipExtra}}" onChange="changeExtra" color="#183e43"/></view><view class="row between"><text class="grow">{{messages.locate}}</text><switch checked="{{locationEnabled}}" onChange="toggleLocation" color="#183e43"/></view><view class="muted">{{locationNote}}</view></view>
        <view a:if="{{visit &amp;&amp; visit.status === 1}}" class="card"><view class="section">{{messages.queueTitle}}</view><view class="muted">{{messages.queueHint}}</view><view a:if="{{!sequence.length}}" class="empty">{{messages.queueEmpty}}</view><view a:for="{{sequence}}" a:key="id" class="sequence-row"><view class="row between"><text class="grow">{{item.name}}</text><text class="muted">{{item.status === 'playing' ? messages.queuePlaying : item.status === 'completed' ? messages.queueCompleted : item.status === 'skipped' ? messages.queueSkipped : messages.queueQueued}}</text></view><view a:if="{{item.status === 'queued'}}" class="actions"><button size="mini" data-id="{{item.id}}" onTap="playQueued" disabled="{{busy || loading}}">{{messages.queuePlay}}</button><button size="mini" data-id="{{item.id}}" onTap="skipQueued" disabled="{{busy || loading}}">{{messages.queueSkip}}</button></view></view></view>
      </block>
    </view>
  </scroll-view>
</view>
