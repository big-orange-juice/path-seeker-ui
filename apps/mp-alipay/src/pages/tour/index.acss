.tour-page { height: 100vh; display: flex; flex-direction: column; }
.map { width: 100%; height: 32vh; flex-shrink: 0; }
.map-actions { padding: 14rpx 22rpx; border-bottom: 1rpx solid #d4e0d9; }
.map-actions button { padding: 10rpx 18rpx; }
.panel { flex: 1; height: 0; }
.selectors { margin-top: 24rpx; flex-wrap: wrap; }
.route-list { width: 100%; margin-top: 24rpx; }
.route-row { display: flex; gap: 18rpx; padding-bottom: 8rpx; }
.route-card { flex-shrink: 0; width: 290rpx; padding: 16rpx; border: 1rpx solid #d4e0d9; background: #fff; border-radius: 18rpx; }
.selected { background: #edf5ef; border-color: #183e43; }
.route-cover { width: 256rpx; height: 150rpx; border-radius: 12rpx; }
.route-name { font-weight: 600; margin: 12rpx 0; }
.stop-list { margin-top: 24rpx; }
.stop-row { display: flex; align-items: center; gap: 16rpx; border: 1rpx solid #d4e0d9; border-radius: 14rpx; padding: 20rpx; margin-bottom: 12rpx; }
.stop-number { color: #183e43; font-size: 25rpx; width: 34rpx; }
.stop-cover { width: 100%; height: 300rpx; border-radius: 16rpx; margin-top: 24rpx; }
.stop-video { width: 100%; margin-top: 24rpx; }
.audio-actions, .navigation { margin-top: 24rpx; }
.chapter { margin-top: 24rpx; border-top: 1rpx solid #d4e0d9; }
.extra-row, .sequence-row { padding: 20rpx 0; border-top: 1rpx solid #d4e0d9; }
.sequence-row .actions { margin-top: 14rpx; }
