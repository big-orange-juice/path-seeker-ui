page { height: 100%; overflow: hidden; }
.tour-page { position: relative; height: 100vh; min-height: 100vh; overflow: hidden; background: #f8faf9; color: #2b4039; }
.stage-language { min-height: 100vh; background: #f5f8f1; }
.tour-map { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.tour-map.map-obscured { visibility: hidden; pointer-events: none; }
.language-gate { position: absolute; left: 0; right: 0; top: 0; bottom: 0; z-index: 20; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 32rpx 42rpx; background: #171710; color: #fff8e8; }
.stage-language .language-gate { position: relative; min-height: 100vh; box-sizing: border-box; }
.stage-overview .language-gate, .stage-navigation .language-gate { display: none; }
.language-gate .eyebrow { color: #d6b773; margin-bottom: 22rpx; }
.language-title { font-size: 44rpx; line-height: 1.35; margin-bottom: 30rpx; }
.language-options { width: 100%; max-width: 600rpx; }
.language-option { display: flex; align-items: center; justify-content: space-between; width: 100%; margin-top: 20rpx; padding: 22rpx 32rpx; border: 1rpx solid #d6b77366; border-radius: 20rpx; background: #d6b7730d; font-size: 32rpx; color: #fff8e8; }
.language-arrow, .language-status { color: #246859; }
.language-status { margin-top: 20rpx; }
.tour-header { position: absolute; left: 0; right: 0; top: 0; z-index: 8; min-height: 100rpx; display: flex; align-items: center; gap: 16rpx; padding: 18rpx 28rpx; background: #f8faf9; border-bottom: 1rpx solid #d4e0d9; }
.area-name { font: 600 32rpx 'Songti SC', 'STSong', serif; letter-spacing: 3rpx; }
.area-caption { display: inline-block; margin-left: 14rpx; color: #7b8a80; font: 18rpx sans-serif; letter-spacing: 2rpx; }
.tour-header .header-button { padding: 10rpx; background: transparent; font-size: 23rpx; }
.journey-header { left: 14rpx; right: 14rpx; top: 16rpx; min-height: 80rpx; padding: 10rpx 14rpx; border: 0; border-radius: 16rpx; box-shadow: 0 5rpx 20rpx #183e4320; background: #f8faf9f5; }
.header-route { font-size: 25rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.overview-heading { position: absolute; left: 0; right: 0; top: 100rpx; z-index: 3; padding: 28rpx; background: linear-gradient(#f8faf9, #f8faf9db, #f8faf900); }
.overview-title { font: 600 44rpx/1.3 'Songti SC', 'STSong', serif; margin-bottom: 10rpx; }
.overview-heading .muted { font-size: 22rpx; }
.route-search { height: 80rpx; margin-top: 24rpx; padding: 0 24rpx; border: 1rpx solid #d4e0d9; border-radius: 20rpx; background: #fff; font-size: 24rpx; box-shadow: 0 6rpx 26rpx #183e4310; }
.start-area { position: absolute; z-index: 4; top: 46%; left: 0; right: 0; display: flex; flex-direction: column; align-items: center; }
.start-ride { display: flex; justify-content: center; align-items: center; gap: 24rpx; max-width: 90%; min-height: 118rpx; padding: 24rpx 36rpx; border: 8rpx solid #ffffffbd; border-radius: 40rpx; background: #183e43; color: #fff; font-size: 34rpx; font-weight: 600; box-shadow: 0 16rpx 54rpx #183e4333; }
.start-icon { font-size: 42rpx; }
.start-hint { margin-top: 14rpx; max-width: 90%; padding: 10rpx 22rpx; border-radius: 30rpx; background: #f8faf9f5; color: #183e43; font-size: 21rpx; text-align: center; }
.route-deck { position: absolute; left: 0; right: 0; bottom: 0; z-index: 4; padding: 40rpx 0 30rpx; background: linear-gradient(#f8faf900, #f8faf9db 22%, #f8faf9); }
.route-list { width: 100%; }
.route-row { display: flex; gap: 20rpx; padding: 8rpx 56rpx 18rpx; }
.route-card { flex: 0 0 540rpx; width: 540rpx; min-height: 310rpx; padding: 26rpx; border: 1rpx solid #ceddd3; background: #fffffff5; border-radius: 26rpx; text-align: left; white-space: normal; opacity: .78; }
.route-card.selected { border: 3rpx solid #183e43; padding: 24rpx; background: #edf5ef; opacity: 1; }
.route-guide { display: flex; align-items: center; justify-content: space-between; color: #183e43; font-size: 22rpx; }
.route-name { margin: 16rpx 0; color: #2b4039; font: 600 34rpx/1.35 'Songti SC', 'STSong', serif; }
.route-style { color: #587466; font-size: 22rpx; }
.route-facts { margin-top: 18rpx; font-size: 22rpx; color: #2b4039; }
.route-subtitle { margin-top: 16rpx; padding-top: 12rpx; border-top: 1rpx solid #d4e0d9; color: #7b8a80; font-size: 20rpx; }
.route-dots { display: flex; gap: 10rpx; justify-content: center; margin-top: 6rpx; }
.route-dot { width: 10rpx; height: 10rpx; border-radius: 8rpx; background: #b9cec3; }
.route-dot.active { width: 30rpx; background: #183e43; }
.tour-notices { position: absolute; top: 108rpx; left: 20rpx; right: 20rpx; z-index: 12; }
.tour-notices .error { margin: 8rpx 0; font-size: 22rpx; padding: 14rpx; }
.notice { padding: 12rpx 18rpx; border-radius: 14rpx; background: #f8faf9ed; font-size: 22rpx; }
.navigation-controls { position: absolute; top: 140rpx; right: 0; bottom: max(28rpx,env(safe-area-inset-bottom)); left: 0; display: flex; flex-direction: column; gap: 24rpx; pointer-events: none; }
.navigation-map-space { position: relative; flex: 1; min-height: 0; }
.map-tools-scroll { position: absolute; z-index: 4; top: 0; left: 18rpx; width: 76rpx; height: 100%; pointer-events: auto; }
.map-tools-center { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100%; padding: 2rpx 0; }
.map-tools { display: flex; flex: 0 0 auto; flex-direction: column; align-items: center; gap: 4rpx; width: 76rpx; padding: 8rpx 6rpx; border: 1rpx solid #d4e0d9; border-radius: 22rpx; background: #f8faf9f2; box-shadow: 0 8rpx 28rpx #183e4330; }
.map-tools .tool-button { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 62rpx; height: 60rpx; padding: 0; border-radius: 14rpx; background: transparent; color: #263f55; }
.map-tools .tool-button.active { background: #e4f0ea; color: #183e43; }
.map-tools .tool-button:disabled { background: transparent; }
.tool-divider { width: 42rpx; height: 1rpx; margin: 3rpx 0; background: #d4e0d9; }
.tool-glyph { font-size: 38rpx; line-height: 1; font-weight: 300; }
.tool-icon { position: relative; display: block; width: 34rpx; height: 34rpx; color: currentColor; }
.route-icon:before, .route-icon:after { content: ''; position: absolute; width: 10rpx; height: 10rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.route-icon:before { left: 1rpx; top: 3rpx; }.route-icon:after { right: 1rpx; bottom: 3rpx; }.route-icon view { position: absolute; left: 8rpx; top: 14rpx; width: 18rpx; height: 3rpx; background: currentColor; transform: rotate(-28deg); }
.focus-icon { border: 3rpx solid currentColor; border-radius: 50%; transform: scale(.64); }.focus-icon:before, .focus-icon:after { content: ''; position: absolute; background: currentColor; }.focus-icon:before { left: 14rpx; top: -10rpx; width: 3rpx; height: 54rpx; }.focus-icon:after { left: -10rpx; top: 14rpx; width: 54rpx; height: 3rpx; }.focus-icon view { position: absolute; inset: 10rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.nav-icon:before { content: ''; position: absolute; left: 7rpx; top: 2rpx; border-left: 11rpx solid transparent; border-right: 11rpx solid transparent; border-bottom: 30rpx solid currentColor; transform: rotate(32deg); }.nav-icon view { position: absolute; left: 15rpx; top: 13rpx; width: 5rpx; height: 5rpx; border-radius: 50%; background: #f8faf9; z-index: 1; }
.chat-icon { border: 3rpx solid currentColor; border-radius: 50%; }.chat-icon:after { content: ''; position: absolute; right: -3rpx; bottom: -8rpx; width: 11rpx; height: 11rpx; border-left: 3rpx solid currentColor; transform: skew(-22deg); }
.tool-ask { height: 64rpx !important; }
.content-sidebar { position: absolute; top: 114rpx; right: 18rpx; bottom: calc(500rpx + env(safe-area-inset-bottom)); z-index: 7; display: flex; flex-direction: column; width: 72%; max-width: 800rpx; border: 1rpx solid #d4e0d9; border-radius: 22rpx; box-shadow: 0 8rpx 40rpx #183e4326; background: #f8faf9f5; overflow: hidden; }
.drawer-header { display: flex; align-items: center; gap: 12rpx; padding: 18rpx 22rpx; border-bottom: 1rpx solid #d4e0d9; }
.drawer-heading { font-size: 32rpx; font-weight: 600; }
.drawer-scroll { flex: 1; height: 0; }
.drawer-inner { padding: 22rpx; }
.stop-tabs { width: 100%; margin: 20rpx 0; }
.stop-tab-row { display: flex; gap: 12rpx; padding-bottom: 10rpx; }
.stop-tab { display: flex; align-items: center; gap: 10rpx; flex: 0 0 auto; min-width: 180rpx; padding: 14rpx 18rpx; font-size: 22rpx; border: 1rpx solid #d4e0d9; border-radius: 12rpx; background: #fff; text-align: left; }
.stop-tab.selected { background: #183e43; color: #fff; }
.stop-number { display: grid; place-items: center; width: 40rpx; height: 40rpx; flex: 0 0 40rpx; border-radius: 10rpx; background: #edf5ef; color: #587466; font-size: 19rpx; font-weight: 700; }
.stop-tab.selected .stop-number { background: #ffffff22; color: #fff; }
.stop-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.stop-cover { width: 100%; height: 280rpx; border-radius: 14rpx; margin-top: 20rpx; }
.stop-video { width: 100%; margin-top: 20rpx; }
.story-alert, .playback-status { margin: 16rpx 0; padding: 14rpx 16rpx; border-radius: 12rpx; background: #edf5ef; color: #41565f; font-size: 21rpx; }
.story-alert { background: #fdf1e3; color: #8a5a24; }
.story-controls { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 22rpx; }
.story-controls button { font-size: 23rpx; padding: 16rpx 18rpx; }
.story-controls .seek-controls { display: flex; width: 100%; gap: 12rpx; }
.story-controls .seek-controls button { flex: 1; }
.story-controls picker { width: 100%; }
.story-controls .field { padding: 16rpx 18rpx; border: 1rpx solid #d4e0d9; border-radius: 12rpx; background: #fff; color: #183e43; font-size: 22rpx; }
.arrival-note { margin-top: 16rpx; color: #587466; font-size: 21rpx; line-height: 1.6; }
.extra-audio { margin-top: 24rpx; padding: 16rpx; border: 1rpx solid #d4e0d9; border-radius: 14rpx; background: #f6faf7; }
.story-body .actions button { font-size: 23rpx; padding: 16rpx 18rpx; }
.chapter { margin-top: 24rpx; border-top: 1rpx solid #d4e0d9; }
.extra-row, .sequence-row { padding: 20rpx 0; border-top: 1rpx solid #d4e0d9; }
.settings-row { display: flex; align-items: center; gap: 12rpx; padding: 18rpx 0; }
.voice-button { position: absolute; right: 30rpx; bottom: 0; z-index: 6; display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; border-radius: 50%; background: #183e43; color: #fff; box-shadow: 0 6rpx 26rpx #183e4333; pointer-events: auto; }
.voice-mic-icon { position: relative; width: 28rpx; height: 38rpx; }
.voice-mic-head { position: absolute; left: 7rpx; top: 0; width: 14rpx; height: 24rpx; border: 3rpx solid currentColor; border-radius: 10rpx; }
.voice-mic-stem { position: absolute; left: 4rpx; bottom: 0; width: 20rpx; height: 14rpx; border: 3rpx solid currentColor; border-top: 0; border-radius: 0 0 12rpx 12rpx; }
.voice-button.holding { background: #a4483b; }
.record-note { position: absolute; bottom: 390rpx; right: 24rpx; z-index: 12; padding: 16rpx; border-radius: 14rpx; background: #f8faf9; color: #183e43; }
.arrival-prompt { position: absolute; right: 24rpx; top: 170rpx; z-index: 11; width: 280rpx; height: 280rpx; overflow: hidden; border: 1rpx solid #d4e0d9; border-radius: 20rpx; background: #f8faf9; color: #183e43; box-shadow: 0 10rpx 30rpx #183e4324; }
.arrival-image, .arrival-shade { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.has-image .arrival-shade { background: linear-gradient(180deg, #102e3655 0%, #102e36b8 48%, #102e36f2 100%); }
.arrival-copy { position: relative; display: flex; flex-direction: column; justify-content: space-between; height: 100%; padding: 18rpx; box-sizing: border-box; }
.arrival-eyebrow { display: flex; justify-content: space-between; gap: 8rpx; font-size: 18rpx; line-height: 1.4; }
.arrival-prompt button { min-height: 0; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: inherit; text-align: left; }
.arrival-prompt button:after { border: 0; }
.arrival-prompt .arrival-enter { display: flex; flex-direction: column; justify-content: center; flex: 1; width: 100%; padding: 12rpx 0; }
.arrival-title { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; font-size: 28rpx; font-weight: 600; line-height: 1.3; }
.arrival-countdown { display: block; margin-top: 10rpx; font-size: 18rpx; line-height: 1.4; opacity: .82; }
.arrival-actions { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; border-top: 1rpx solid #183e4324; }
.arrival-actions button { min-width: 0; overflow: hidden; padding-top: 12rpx; font-size: 19rpx; line-height: 1.5; white-space: nowrap; text-overflow: ellipsis; }
.arrival-actions .arrival-cycle { flex: 0 0 36rpx; text-align: right; }
.has-image { color: #fff; border-color: #183e4330; }
.has-image .arrival-actions { border-top-color: #ffffff40; }
@media (max-width: 760px) { .content-sidebar { left: 18rpx; width: auto; max-width: none; } }
@media (max-height: 640px) { .start-area { top: 40%; } .route-card { min-height: 230rpx; } .route-subtitle { display: none; } .route-name { margin: 10rpx 0; font-size: 30rpx; } .route-deck { padding-bottom: 18rpx; } }
.tour-playback-dock{position:relative;flex-shrink:0;margin:0 24rpx;z-index:8;padding:0 28rpx 12rpx;border:1px solid #d4e0d9;border-radius:44rpx;background:#fcfefd;box-shadow:0 20rpx 70rpx #183e4324;color:#183e43;box-sizing:border-box;pointer-events:auto}
.dock-location-note{margin:12rpx 0 0;color:#75897d;font-size:21rpx;line-height:1.6}
@media(max-height:600px){.content-sidebar{bottom:calc(390rpx + env(safe-area-inset-bottom))}.arrival-prompt{top:110rpx}}
.dock-modes{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:88rpx;border-bottom:1px solid #e3ece7}
.dock-modes button{display:flex;align-items:center;justify-content:flex-start;gap:12rpx;min-height:88rpx;margin:0;padding:8rpx 0;border:0;border-radius:0;background:transparent;color:#183e43;font-size:20rpx;line-height:1.4;text-align:left}
.dock-room{font-weight:600}.dock-nearby{max-width:60%;color:#74877e!important}.dock-nearby.is-active{color:#183e43!important}
.dock-switch{position:relative;flex:0 0 48rpx;height:28rpx;border-radius:20rpx;background:#cedbd3}.dock-switch view{position:absolute;top:6rpx;left:6rpx;width:16rpx;height:16rpx;border-radius:50%;background:#fff}.is-active .dock-switch{background:#367a68}.is-active .dock-switch view{left:26rpx}
.dock-live-dot{flex:0 0 12rpx;height:12rpx;border-radius:50%;background:#3b9279}
.dock-headphones-icon{position:relative;box-sizing:border-box;flex:0 0 28rpx;width:28rpx;height:28rpx;border:3rpx solid currentColor;border-bottom:0;border-radius:18rpx 18rpx 0 0}.dock-headphones-icon:before,.dock-headphones-icon:after{position:absolute;bottom:-2rpx;width:6rpx;height:14rpx;border-radius:3rpx;background:currentColor;content:''}.dock-headphones-icon:before{left:-3rpx}.dock-headphones-icon:after{right:-3rpx}
.dock-main{display:flex;align-items:center;gap:24rpx;padding:24rpx 0 12rpx}.dock-main button{margin:0}
.dock-play{display:flex;align-items:center;justify-content:center;flex:0 0 96rpx;width:96rpx;height:96rpx;min-height:96rpx;padding:0;border:0;border-radius:32rpx;background:#183e43;color:#fff;box-shadow:0 8rpx 24rpx #183e4320}
.dock-play-icon{width:0;height:0;margin-left:6rpx;border-top:16rpx solid transparent;border-bottom:16rpx solid transparent;border-left:24rpx solid currentColor}.dock-pause-icon{width:26rpx;height:32rpx;border-left:8rpx solid currentColor;border-right:8rpx solid currentColor;box-sizing:border-box}
.dock-story{display:block;flex:1;min-width:0;padding:0;border:0;border-radius:0;background:transparent;color:#183e43;text-align:left;line-height:1.4}.dock-caption{color:#71867a;font-size:19rpx}.dock-story-title{overflow:hidden;margin-top:6rpx;font:600 34rpx/1.4 'Songti SC','STSong',serif;text-overflow:ellipsis;white-space:nowrap}.dock-item-title{overflow:hidden;margin-top:4rpx;color:#74877e;font-size:20rpx;text-overflow:ellipsis;white-space:nowrap}
.dock-queue{display:flex;align-items:center;justify-content:center;gap:10rpx;flex:0 0 94rpx;min-height:84rpx;padding:14rpx;border:0;border-radius:24rpx;background:#edf4ef;color:#183e43;font-size:21rpx}.dock-queue.is-active{background:#183e43;color:#fff}
.dock-list-icon{display:flex;flex-direction:column;justify-content:space-between;width:30rpx;height:26rpx}.dock-list-icon view{height:3rpx;border-radius:3rpx;background:currentColor}.dock-list-icon view:last-child{width:66%}
.dock-timeline{display:flex;align-items:center;gap:14rpx;color:#71867a;font-size:19rpx;font-variant-numeric:tabular-nums}.dock-timeline slider{flex:1;min-width:0;margin:12rpx 8rpx}
.dock-transport{display:flex;align-items:center;gap:8rpx}.dock-transport button{display:flex;align-items:center;justify-content:center;flex:1;gap:8rpx;min-height:84rpx;margin:0;padding:8rpx 2rpx;border:0;border-radius:20rpx;background:transparent;color:#536f62;font-size:21rpx;line-height:1.4}.dock-transport button:first-child,.dock-transport button:last-child{flex:1.5}.dock-transport text{font-size:32rpx}
.tour-queue-layer{position:absolute;inset:0;z-index:20}.queue-mask{position:absolute;inset:0;background:#183e434d}
.queue-sidebar{position:absolute;left:0;right:0;bottom:0;display:flex;flex-direction:column;max-height:80vh;padding:16rpx 40rpx max(40rpx,env(safe-area-inset-bottom));border:1px solid #d4e0d9;border-bottom:0;border-radius:52rpx 52rpx 0 0;background:#fcfefd;color:#183e43;box-shadow:0 -20rpx 80rpx #183e4324;box-sizing:border-box}
.queue-grip{align-self:center;flex:0 0 8rpx;width:64rpx;margin-bottom:16rpx;border-radius:8rpx;background:#d4e2da}.queue-header{display:flex;align-items:center;justify-content:space-between;gap:24rpx;flex-shrink:0}.queue-heading{display:flex;align-items:center;gap:24rpx}.queue-heading-icon{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;border-radius:28rpx;background:#e9f2ed;color:#183e43}.queue-title{font:600 40rpx/1.4 'Songti SC','STSong',serif}.queue-caption{margin-top:8rpx;color:#75897d;font-size:22rpx}.queue-close{display:flex;align-items:center;justify-content:center;flex:0 0 84rpx;width:84rpx;height:84rpx;margin:0;padding:0;border:0;border-radius:24rpx;background:#edf3ef;color:#183e43;font-size:42rpx}
.queue-hint{flex-shrink:0;margin:24rpx 0;color:#75897d;font-size:23rpx;line-height:1.7}.queue-settings{flex-shrink:0;margin-bottom:24rpx;padding:6rpx 24rpx;border:1px solid #e0e9e3;border-radius:32rpx;background:#f3f7f4}.queue-setting{display:flex;align-items:center;gap:20rpx;min-height:88rpx;color:#436354;font-size:24rpx;line-height:1.5}.queue-setting+.queue-setting{border-top:1px solid #e0e9e3}.queue-setting switch{flex-shrink:0;transform:scale(.8);transform-origin:right center}.queue-location-note{flex-shrink:0;margin-bottom:20rpx;color:#75897d;font-size:21rpx;line-height:1.6}
.queue-scroll{flex:0 1 44vh;min-height:0;height:44vh;max-height:44vh}.queue-item{display:flex;align-items:center;gap:22rpx;min-height:132rpx;padding:20rpx 14rpx;border-top:1px solid #e4ece6;box-sizing:border-box}.queue-item:first-child{border:0}.queue-item.is-playing{padding:20rpx;border-color:transparent;border-radius:32rpx;background:#e9f2ed}.queue-item.is-playing+.queue-item{border-color:transparent}.queue-marker{display:flex;align-items:center;justify-content:center;flex:0 0 60rpx;height:60rpx;border:1px solid #dce6df;border-radius:22rpx;background:#fff;color:#688171;font-size:22rpx}.is-playing .queue-marker{border-color:#183e43;background:#183e43;color:#fff}.queue-item-copy{flex:1;min-width:0}.queue-item-name{overflow:hidden;color:#294b3d;font-size:27rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}.queue-item-status{margin-top:8rpx;color:#75897d;font-size:21rpx}.is-playing .queue-item-status{color:#357965}.is-completed,.is-skipped{opacity:.6}
.queue-item-action{display:flex;align-items:center;justify-content:center;flex:0 0 76rpx;width:76rpx;height:84rpx;margin:0;padding:0;border:0;border-radius:22rpx;background:#eaf2ed;color:#183e43;font-size:40rpx}.queue-item-action .dock-play-icon{border-top-width:11rpx;border-bottom-width:11rpx;border-left-width:17rpx}.queue-item-action.is-muted{background:transparent;color:#8b9b91}.queue-empty{padding:60rpx 32rpx;border:1px dashed #d4e2da;border-radius:32rpx;color:#75897d;font-size:25rpx;line-height:1.8;text-align:center}
@media(max-height:600px){.dock-main{padding-top:14rpx}.dock-item-title{display:none}.dock-modes,.dock-modes button{min-height:72rpx}.dock-transport button{min-height:64rpx}.voice-button{display:none}.queue-sidebar{max-height:94vh}.queue-hint{margin:12rpx 0}.queue-settings{margin-bottom:12rpx}.queue-setting{min-height:72rpx}}
.language-gate { background: #f5f8f1; color: #243d37; }
.language-gate .eyebrow, .language-arrow { color: #246859; }
.language-option { background: #fffef8; border-color: #cedbd0; color: #243d37; border-radius: 16rpx; }
.sequence-video { position: absolute; top: 20%; left: 20rpx; right: 20rpx; z-index: 70; padding: 24rpx; background: #fffef8; border: 1rpx solid #cedbd0; border-radius: 20rpx; box-shadow: 0 20rpx 60rpx #183e4344; }
.sequence-video video { width: 100%; height: 420rpx; }
.sequence-video-heading{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:16rpx}.sequence-video-title{flex:1;min-width:120rpx;word-break:break-all}.sequence-video-actions{display:flex;flex-wrap:wrap;max-width:100%;gap:12rpx}.sequence-video-actions button{margin:0;min-height:76rpx;padding:8rpx 16rpx;border:1rpx solid #d4e0d9;border-radius:16rpx;background:#edf5ef;color:#183e43;font-size:24rpx}
.story-carousel{margin:24rpx 0 28rpx}.story-image-swiper{width:100%;height:340rpx;overflow:hidden;border-radius:20rpx;background:#eaf1ec}.story-carousel-image{display:block;width:100%;height:100%}.story-image-navigation{display:flex;align-items:center;justify-content:center;gap:32rpx;margin-top:14rpx;color:#7b8a80;font-size:23rpx}.story-image-navigation button{display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;min-height:68rpx;margin:0;padding:0;border:1rpx solid #d4e0d9;border-radius:18rpx;background:#edf5ef;color:#183e43;font-size:36rpx}.story-image-caption{margin-top:12rpx;color:#7b8a80;font-size:23rpx;line-height:1.6;text-align:center}.story-video-button{width:100%;min-height:84rpx;margin-top:28rpx;border:1rpx solid #d4e0d9;background:#edf5ef;color:#183e43}
