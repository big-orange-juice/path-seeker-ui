<view class="tour-page stage-{{tourStage}}">
  <map a:if="{{tourStage !== 'language'}}" id="tour-map" class="tour-map {{chatOpen ? 'map-obscured' : ''}}" longitude="{{map.longitude}}" latitude="{{map.latitude}}" scale="{{mapScale || 15}}" rotate="{{mapRotation || 0}}" skew="{{tourStage == 'navigation' ? mapSkew : 0}}" setting="{{mapSettings}}" enable-building="{{true}}" enable-overlooking="{{true}}" onInitComplete="mapReady" onRegionChange="inspectMapCamera" markers="{{map.markers}}" polyline="{{map.polyline}}" include-points="{{map.includePoints}}" show-location="{{locationEnabled}}" optimize="{{true}}" onMarkerTap="marker" onCalloutTap="marker" />
  <view class="language-gate">
    <view class="eyebrow">PATH SEEKER</view><view class="language-title">选择语言 / Choose language</view>
    <view class="language-options"><button class="language-option" data-index="0" onTap="chooseLanguage" disabled="{{loading || busy}}">中文<text class="language-arrow">→</text></button><button class="language-option" data-index="1" onTap="chooseLanguage" disabled="{{loading || busy}}">English<text class="language-arrow">→</text></button><button class="language-option" data-index="2" onTap="chooseLanguage" disabled="{{loading || busy}}">Русский<text class="language-arrow">→</text></button><button class="language-option" data-index="3" onTap="chooseLanguage" disabled="{{loading || busy}}">Español<text class="language-arrow">→</text></button><button class="language-option" data-index="4" onTap="chooseLanguage" disabled="{{loading || busy}}">Français<text class="language-arrow">→</text></button><button class="language-option" data-index="5" onTap="chooseLanguage" disabled="{{loading || busy}}">日本語<text class="language-arrow">→</text></button></view>
    <view a:if="{{loading}}" class="language-status">{{messages.loading}}</view><view a:if="{{error}}" class="error">{{error}}<button size="mini" onTap="retry">{{messages.retry}}</button></view>
  </view>
  <block a:if="{{tourStage != 'language'}}">
    <view class="tour-header {{tourStage === 'navigation' ? 'journey-header' : ''}}">
      <block a:if="{{tourStage == 'overview'}}"><picker class="grow" range="{{destinations}}" range-key="name" value="{{destinationIndex}}" onChange="chooseDestination"><view class="area-name">{{destinationName || '城市漫游'}}<text class="area-caption">PATH SEEKER</text></view></picker><button size="mini" class="header-button" onTap="showLanguage">{{locales[localeIndex].label}} ▾</button></block>
      <block a:else><button size="mini" class="header-button" onTap="backToOverview" disabled="{{busy || loading}}">‹ {{messages.back}}</button><text class="header-route grow">{{route.title}}</text><button size="mini" class="header-button" onTap="endVisit" disabled="{{busy || loading || !visit}}">{{messages.end}}</button></block>
    </view>
    <view a:if="{{error || audioError || loading}}" class="tour-notices"><view a:if="{{error}}" class="error">{{error}}<button size="mini" onTap="retry">{{messages.retry}}</button></view><view a:if="{{audioError}}" class="error">{{audioError}}<button size="mini" onTap="openContent">{{messages.content}}</button></view><view a:if="{{loading}}" class="notice">{{messages.loading}}</view></view>
    <block a:if="{{tourStage == 'overview'}}">
      <view class="overview-heading"><view class="overview-title">{{messages.routes}}</view><view class="muted">{{messages.routeHint}}</view><input class="route-search" placeholder="{{messages.search}}" value="{{search}}" onInput="search" /></view>
      <view class="start-area"><button class="start-ride" disabled="{{busy || loading || !route || !stops.length}}" onTap="startVisit"><text class="start-icon">♫</text><text>{{visit && visit.status === 1 ? messages.resume : messages.start}}</text><text>→</text></button><view class="start-hint">{{messages.startHint}}</view></view>
      <view class="route-deck"><scroll-view class="route-list" scroll-x="true" scroll-into-view="route-{{route.id}}" scroll-with-animation="true"><view class="route-row"><button a:for="{{routes}}" a:key="id" id="route-{{item.id}}" class="route-card {{route && route.id === item.id ? 'selected' : ''}}" data-id="{{item.id}}" onTap="chooseRoute" disabled="{{busy || loading}}"><view class="route-guide">♫ {{item.guideName || messages.guide}}<text a:if="{{route && route.id === item.id}}">✓</text></view><view class="route-name">{{item.title}}</view><view class="route-style">{{item.guideStyle || item.subtitle}}</view><view class="route-facts">{{item.durationMinutes || '—'}} {{messages.minutes}} · {{item.stopCount || 0}} {{messages.stops}}</view><view a:if="{{item.subtitle && item.guideStyle}}" class="route-subtitle">{{item.subtitle}}</view></button></view></scroll-view><view a:if="{{!loading && !routes.length}}" class="empty">{{messages.noRoutes}}</view><view class="route-dots"><view a:for="{{routes}}" a:key="id" class="route-dot {{route && route.id === item.id ? 'active' : ''}}"/></view></view>
    </block>
    <block a:if="{{tourStage == 'navigation'}}">
      <button class="location-status" size="mini" onTap="toggleTracking">{{locationEnabled ? messages.locationReady : messages.locationOff}}</button>
      <view class="map-tools" aria-label="{{messages.routeTools}}"><button size="mini" class="tool-button {{showRoute ? 'active' : ''}}" onTap="toggleRoute" aria-label="{{showRoute ? messages.hideRoute : messages.showRoute}}"><view class="tool-icon route-icon"><view /></view></button><view class="tool-divider" /><button size="mini" class="tool-button" onTap="zoomOut" aria-label="{{messages.zoomOut}}"><text class="tool-glyph">−</text></button><button size="mini" class="tool-button" onTap="overview" aria-label="{{messages.overview}}"><view class="tool-icon focus-icon"><view /></view></button><button size="mini" class="tool-button {{following ? 'active' : ''}}" onTap="toggleFollow" disabled="{{!locationEnabled}}" aria-label="{{following ? messages.unfollow : messages.follow}}"><view class="tool-icon nav-icon"><view /></view></button><button size="mini" class="tool-button" onTap="zoomIn" aria-label="{{messages.zoomIn}}"><text class="tool-glyph">＋</text></button><button size="mini" class="tool-button" onTap="focusNavigationMap" aria-label="3D"><text>3D</text></button><view class="tool-divider" /><button size="mini" class="tool-button tool-ask" onTap="ask" aria-label="{{messages.ask}}"><view class="tool-icon chat-icon"><view /></view></button></view>
      <view a:if="{{candidates.length && !chatOpen}}" class="arrival-prompt"><view class="drawer-heading">{{candidates.length > 1 ? messages.overlappingStops : messages.nearbyStop}}</view><view a:for="{{candidates}}" a:key="id" class="arrival-candidate"><view class="grow"><view class="arrival-title">{{item.withinRange ? messages.arrived : messages.approaching}} {{item.name}}</view><view class="muted">{{item.distanceLabel}}</view></view><button size="mini" class="primary" data-id="{{item.id}}" onTap="enterCandidate" disabled="{{busy || loading}}">{{messages.enterStop}}</button></view><button size="mini" class="quiet" onTap="dismissCandidates">{{messages.keepNarration}}</button></view>
      <view a:if="{{contentOpen && stop}}" class="content-sidebar"><view class="drawer-header"><text class="drawer-heading grow">{{stop.name}}</text><button size="mini" class="quiet" onTap="closeContent">{{messages.close}} ×</button></view><scroll-view class="drawer-scroll" scroll-y="true"><view class="drawer-inner"><view class="row between muted"><text>{{messages.stops}}</text><text>{{stopIndex + 1}} / {{stops.length}}</text></view><scroll-view class="stop-tabs" scroll-x="true" scroll-into-view="stop-{{stop.id}}"><view class="stop-tab-row"><button a:for="{{stops}}" a:key="id" id="stop-{{item.id}}" class="stop-tab {{stopIndex === index ? 'selected' : ''}}" data-index="{{index}}" onTap="browse" disabled="{{busy || loading}}"><text class="stop-number">{{item.displayOrder || index + 1}}</text><text class="stop-name">{{item.name}}</text></button></view></scroll-view><include src="./story.axml" /></view></scroll-view></view>
      <view a:if="{{queueOpen}}" class="queue-sidebar"><view class="drawer-header"><text class="drawer-heading grow">{{messages.queueTitle}}</text><button size="mini" class="quiet" onTap="closeQueue">{{messages.close}} ×</button></view><scroll-view class="drawer-scroll" scroll-y="true"><view class="drawer-inner"><view class="settings-row"><text class="grow">{{messages.queueAutoPlay}}</text><switch checked="{{autoplay}}" onChange="changeAutoplay" color="#183e43"/></view><view class="settings-row"><text class="grow">{{messages.queueUnlockContent}}</text><switch checked="{{!lockContent}}" onChange="changeContentSwitch" color="#183e43"/></view><view class="settings-row"><text class="grow">{{messages.skipExtraAudio}}</text><switch checked="{{skipExtra}}" onChange="changeExtra" color="#183e43"/></view><view class="muted">{{locationNote}}</view><view class="subtitle">{{messages.queueHint}}</view><view a:if="{{!sequence.length}}" class="empty">{{messages.queueEmpty}}</view><view a:for="{{sequence}}" a:key="id" class="sequence-row"><view class="row between"><text class="grow">{{item.name}}</text><text class="muted">{{item.status === 'playing' ? messages.queuePlaying : item.status === 'completed' ? messages.queueCompleted : item.status === 'skipped' ? messages.queueSkipped : messages.queueQueued}}</text></view><view a:if="{{item.status === 'queued'}}" class="actions"><button size="mini" data-id="{{item.id}}" onTap="playQueued" disabled="{{busy || loading}}">{{messages.queuePlay}}</button><button size="mini" data-id="{{item.id}}" onTap="skipQueued" disabled="{{busy || loading}}">{{messages.queueSkip}}</button></view></view></view></scroll-view></view>
      <view a:if="{{!contentOpen && stop}}" class="playback-dock"><view class="dock-controls"><button disabled="{{stopIndex === 0 || busy || loading}}" onTap="previous">‹</button><button onTap="backAudio">−15</button><button class="primary" disabled="{{busy || loading}}" onTap="togglePlay">{{playing ? messages.pause : messages.play}}</button><button onTap="forwardAudio">+15</button><button disabled="{{stopIndex + 1 >= stops.length || busy || loading}}" onTap="next">›</button></view><view class="row dock-summary"><view class="grow" onTap="openContent"><view class="dock-title">{{stop.name}}</view><view class="muted">{{stopIndex + 1}} / {{stops.length}} · {{messages.content}} · {{timeLabel}} / {{durationLabel}}</view><view a:if="{{itemTitle}}" class="muted">{{messages.playingNow}} · {{itemTitle}}</view></view><button size="mini" onTap="toggleQueue">☷ {{sequence.length}}</button></view></view>
      <view class="voice-button" role="button" aria-label="{{messages.voiceHint}}" onTap="startRecording"><view class="voice-mic-icon"><view class="voice-mic-head" /><view class="voice-mic-stem" /></view></view>
    </block>
  </block>
  <chat-panel a:if="{{chatOpen}}" onClose="closeChat" onInterrupt="chatInterrupt" onSettled="chatSettled"/>
</view>
