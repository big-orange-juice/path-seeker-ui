<view a:if="{{embedded && !expanded}}" class="chat-backdrop" onTap="backToTour" />
<view class="chat-page {{embedded ? (expanded ? 'chat-expanded' : 'chat-sheet') : ''}} {{mode === 'voice' ? 'voice-mode' : ''}}">
  <view a:if="{{embedded && !expanded}}" class="chat-grab"><view class="chat-grab-bar" /></view>
  <view class="chat-header">
    <view class="chat-brand"><view class="chat-avatar"><view class="audio-lines-icon"><view /><view /><view /><view /></view></view><view><view class="eyebrow">户外小助手</view><view class="chat-title">{{mode === 'voice' ? '语音模式' : '问一问'}}</view></view></view>
    <view class="chat-head-actions">
      <view class="mode-switch"><button size="mini" class="mode-button {{mode === 'text' ? 'active' : ''}}" data-mode="text" onTap="toggleMode">文字</button><button size="mini" class="mode-button {{mode === 'voice' ? 'active' : ''}}" data-mode="voice" onTap="toggleMode"><view class="mini-audio-icon"><view /><view /><view /></view>语音</button></view>
      <button a:if="{{bargeInSupported}}" size="mini" class="icon-button {{bargeInEnabled ? 'active' : ''}}" onTap="toggleBargeIn"><view class="header-mic-icon"><view class="header-mic-head" /><view class="header-mic-stem" /></view></button><button size="mini" class="icon-button" onTap="toggleExpanded">{{embedded ? (expanded ? '⌄' : '↗') : '↙'}}</button><button size="mini" class="icon-button" onTap="backToTour">×</button>
    </view>
  </view>
  <view class="context">{{contextTitle}}</view>
  <view a:if="{{error}}" class="chat-banner error">{{error}}</view><view a:elif="{{loading}}" class="chat-banner muted">正在加载历史…</view>
  <view a:if="{{mode === 'voice'}}" class="voice-status"><text class="voice-phase">{{recording ? '收音中' : transcribing ? '正在识别' : busy ? '正在回答' : '就绪'}}</text><text class="voice-hint">{{recording ? '松开发送，上滑取消' : '回复会出现在下方气泡中'}}</text></view>
  <view a:if="{{caption}}" class="caption"><text>{{caption}}</text><view class="caption-track"><view class="caption-progress" style="width: {{captionProgress}}%;" /></view></view>
  <scroll-view class="conversation" scroll-y="true" scroll-into-view="{{scrollTarget}}" scroll-with-animation="true"><view class="chat-content">
    <view a:if="{{showSessions}}" class="history-card"><view a:if="{{!sessions.length}}" class="muted">还没有历史对话</view><view a:for="{{sessions}}" a:key="id" class="session row between"><view class="grow" data-id="{{item.id}}" onTap="selectSession">{{item.title || '未命名对话'}}<view class="muted">{{item.lastActiveAt}}</view></view><button size="mini" data-id="{{item.id}}" onTap="archiveSession" disabled="{{busy}}">删除</button></view></view>
    <view a:if="{{!messages.length && !loading}}" class="welcome"><view class="welcome-title">你好，我在路上。</view><view class="welcome-copy">{{mode === 'voice' ? '打字提问，我会朗读回复；位置等信息可在气泡里点开。' : '想了解这一站的故事、路线怎么走，都可以跟我说。'}}</view><view class="suggestions"><button data-text="这条路线有什么值得看的？" onTap="suggest">有什么值得看的？</button><button data-text="请介绍一下当前景点的历史" onTap="suggest">了解景点历史</button></view></view>
    <view a:for="{{messages}}" a:for-item="message" a:for-index="messageIndex" a:key="domId" id="{{message.domId}}" class="message {{message.role === 'user' ? 'user-message' : 'assistant-message'}}"><view class="message-label">{{message.role === 'user' ? '我' : '寻迹向导'}}</view><rich-text a:if="{{message.role !== 'user' && message.nodes}}" nodes="{{message.nodes}}" /><text a:else class="story">{{message.content}}</text><view a:if="{{message.audioPaths && message.audioPaths.length}}" class="message-actions"><button size="mini" data-index="{{messageIndex}}" onTap="playAnswer">{{playingId === message.id ? '停止朗读' : '朗读回答'}}</button></view><view a:if="{{message.error}}" class="error">{{message.error}}<button a:if="{{message.retryText}}" size="mini" data-index="{{messageIndex}}" onTap="retry">重试</button></view><view a:for="{{message.sources}}" a:for-item="source" a:for-index="sourceIndex" a:key="exhibitId" class="source row" data-index="{{messageIndex}}" data-source="{{sourceIndex}}" onTap="showSource"><image a:if="{{source.imageUrl}}" src="{{source.imageUrl}}" class="source-image" mode="aspectFill"/><text>{{source.name || source.formalName || '相关资料'}}</text></view><button a:for="{{message.locations}}" a:for-item="place" a:for-index="placeIndex" a:key="exhibitId" class="location-button" data-index="{{messageIndex}}" data-location="{{placeIndex}}" onTap="openLocation">查看位置 · {{place.exhibitName || (place.siteArea && place.siteArea.name) || '景点'}}</button><view class="suggestions"><button a:for="{{message.suggestions}}" a:key="*this" size="mini" data-text="{{item}}" onTap="suggest" disabled="{{busy}}">{{item}}</button></view></view>
  </view></scroll-view>
    <view class="composer"><view a:if="{{contextTitle}}" class="context-chip"><text class="chip-label">附件</text><text class="chip-text">{{contextTitle}}</text><text class="chip-close">×</text></view><view a:if="{{error}}" class="error composer-error">{{error}}</view><view class="composer-inner"><textarea class="message-input grow" value="{{text}}" maxlength="4000" auto-height="true" placeholder="{{mode === 'voice' ? '按住说话' : '问问位置、故事或观察重点…'}}" onInput="input" disabled="{{recording || transcribing}}"/><button a:if="{{mode === 'voice'}}" class="mic-button {{recording ? 'holding' : ''}}" onTouchStart="startRecording" onTouchMove="moveRecording" onTouchEnd="stopRecording" onTouchCancel="cancelTouch"><view class="mic-icon"><view class="mic-head" /><view class="mic-stem" /></view></button><button class="send-button" disabled="{{!text || loading || recording || transcribing || busy}}" onTap="send">{{busy ? '…' : '➤'}}</button></view></view>
</view>
