# 后端根地址，须已含 /api 前缀（如 https://host/path-seeker/api），业务 path 勿再写 /api
VITE_API_BASE_URL=
VITE_MUSEUM_ID=

# MiniMax 同步语音合成（仅内测直连；Key 会暴露在浏览器，生产务必走服务端代理）
VITE_MINIMAX_API_KEY=
# 留空则走同源 /minimax-tts：
# - 本地：Vite 代理（vite.config.ts）
# - 生产：须在 Nginx 配置反代，见 docs/h5-client-minimax-tts-proxy.md
# 勿直接填 https://api.minimaxi.com（浏览器会 CORS）
VITE_MINIMAX_TTS_BASE_URL=
VITE_MINIMAX_TTS_MODEL=speech-2.8-turbo
VITE_MINIMAX_TTS_VOICE_ID=male-qn-qingse
